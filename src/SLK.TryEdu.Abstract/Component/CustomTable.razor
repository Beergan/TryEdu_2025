@typeparam TItem
@using System.Reflection
@using System.ComponentModel.DataAnnotations
<div class="custom-table-container">
    @if (AllowFiltering)
    {
        <div class="filter-section mb-3">
            <div class="row">
                <div class="col-md-6">
                    <input type="text"
                           class="form-control"
                           placeholder="Tìm kiếm..."
                           @bind="FilterText"
                           @bind:event="oninput"
                           @onkeyup="ApplyFilter" />
                </div>
            </div>
        </div>
    }
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="table-light">
                <tr>
                    @foreach (var prop in _properties)
                    {
                        <th @onclick="() => SortByColumn(prop.Name)"
                            class="@(AllowSorting ? "sortable" : "")">
                            @GetDisplayName(prop)
                            @if (AllowSorting && _sortColumn == prop.Name)
                            {
                                <i class="fas fa-sort-@(_sortAscending ? "up" : "down") ms-1"></i>
                            }
                        </th>
                    }
                    @if (Actions != null)
                    {
                        <th style="width: 120px" class="text-end">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_pagedData != null && _pagedData.Any())
                {
                    @foreach (var item in _pagedData)
                    {
                        <tr>
                            @foreach (var prop in _properties)
                            {
                                <td>@FormatValue(prop.GetValue(item))</td>
                            }
                            @if (Actions != null)
                            {
                                <td class="text-end">
                                    @Actions(item)
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(_properties.Count + (Actions != null ? 1 : 0))" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2"></i>
                            <div>Không có dữ liệu</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (AllowPaging && _totalPages > 1)
    {
        <div class="pagination-container d-flex justify-content-between align-items-center flex-wrap">
            <div class="page-info mb-2 mb-md-0">
                <small class="text-muted">
                    Hiển thị <strong>@(_currentPage* PageSize - PageSize + 1)</strong> -
                    <strong>@Math.Min(_currentPage * PageSize, _totalItems)</strong>
                    trong tổng số <strong>@_totalItems</strong> bản ghi
                </small>
            </div>

            <nav class="mb-2 mb-md-0">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" @onclick="() => GoToPage(1)">
                            <i class="fas fa-angle-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" @onclick="() => GoToPage(_currentPage - 1)">
                            <i class="fas fa-angle-left"></i>
                        </a>
                    </li>

                    @foreach (var pageNum in GetPageNumbers())
                    {
                        @if (pageNum == -1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item @(pageNum == _currentPage ? "active" : "")">
                                <a class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</a>
                            </li>
                        }
                    }

                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <a class="page-link" @onclick="() => GoToPage(_currentPage + 1)">
                            <i class="fas fa-angle-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <a class="page-link" @onclick="() => GoToPage(_totalPages)">
                            <i class="fas fa-angle-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="page-size-selector">
                <select class="form-select form-select-sm" @onchange="ChangePageSize">
                    @foreach (var size in PageSizes)
                    {
                        <option value="@size" selected="@(PageSize == size)">@size / trang</option>
                    }
                </select>
            </div>
        </div>
    }
</div>

<style>
    .custom-table-container {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 1rem;
    }

    .table {
        margin-bottom: 0;
    }

        .table th {
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #dee2e6;
            padding: 1rem 0.75rem;
            white-space: nowrap;
        }

        .table td {
            padding: 0.75rem;
            vertical-align: middle;
        }

        .table th.sortable {
            cursor: pointer;
            user-select: none;
            transition: all 0.2s ease;
        }

            .table th.sortable:hover {
                background-color: #e9ecef !important;
                color: #0d6efd;
            }

    .pagination-container {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #dee2e6;
        gap: 1rem;
    }

    .page-link {
        cursor: pointer;
        color: #0d6efd;
        border: 1px solid #dee2e6;
        padding: 0.375rem 0.75rem;
        transition: all 0.2s ease;
    }

        .page-link:hover {
            background-color: #e7f1ff;
            border-color: #0d6efd;
        }

    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .page-item.disabled .page-link {
        cursor: not-allowed;
        opacity: 0.5;
        pointer-events: none;
    }

    .filter-section input {
        border-radius: 6px;
        border: 1px solid #ced4da;
    }

        .filter-section input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

    @@media (max-width: 768px) {
        .pagination-container {
            flex-direction: column;
            align-items: stretch !important;
        }

        .custom-table-container {
            padding: 1rem;
        }
    }
</style>

@code {
    [Parameter] public IEnumerable<TItem> DataSource { get; set; }
    [Parameter] public RenderFragment<TItem> Actions { get; set; }
    [Parameter] public int PageSize { get; set; } = 50;
    [Parameter] public int[] PageSizes { get; set; } = new[] { 10, 25, 50, 100 };
    [Parameter] public bool AllowPaging { get; set; } = true;
    [Parameter] public bool AllowFiltering { get; set; } = true;
    [Parameter] public bool AllowSorting { get; set; } = true;
    [Parameter] public string[] ExcludeProperties { get; set; }

    private List<PropertyInfo> _properties = new();
    private IEnumerable<TItem> _filteredData = new List<TItem>();
    private IEnumerable<TItem> _pagedData = new List<TItem>();
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _totalItems = 0;
    private string FilterText { get; set; } = "";
    private string _sortColumn = "";
    private bool _sortAscending = true;

    protected override void OnInitialized()
    {
        var type = typeof(TItem);
        _properties = type.GetProperties()
            .Where(p => p.CanRead && IsSimpleType(p.PropertyType))
            .Where(p => ExcludeProperties == null || !ExcludeProperties.Contains(p.Name))
            .ToList();
    }

    protected override void OnParametersSet()
    {
        _filteredData = DataSource ?? new List<TItem>();
        ApplyFilter();
    }

    private bool IsSimpleType(Type type)
    {
        return type.IsPrimitive
            || type.IsEnum
            || type == typeof(string)
            || type == typeof(decimal)
            || type == typeof(DateTime)
            || type == typeof(DateTimeOffset)
            || type == typeof(TimeSpan)
            || type == typeof(Guid)
            || Nullable.GetUnderlyingType(type) != null;
    }

    private string GetDisplayName(PropertyInfo prop)
    {
        var displayAttr = prop.GetCustomAttribute<DisplayAttribute>();
        if (displayAttr != null && !string.IsNullOrEmpty(displayAttr.Name))
            return displayAttr.Name;

        return System.Text.RegularExpressions.Regex.Replace(prop.Name, "([a-z])([A-Z])", "$1 $2");
    }

    private string FormatValue(object? value)
    {
        if (value == null) return "";

        if (value is DateTime dt)
            return dt.ToString("dd/MM/yyyy");

        if (value is bool b)
            return b ? "✓" : "✗";

        if (value is decimal || value is double || value is float)
            return string.Format("{0:N0}", value);

        return value.ToString() ?? "";
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(FilterText))
        {
            _filteredData = DataSource ?? new List<TItem>();
        }
        else
        {
            var searchText = FilterText.ToLower().Trim();
            _filteredData = (DataSource ?? new List<TItem>()).Where(item =>
            {
                foreach (var prop in _properties)
                {
                    var value = prop.GetValue(item)?.ToString()?.ToLower();
                    if (value != null && value.Contains(searchText))
                        return true;
                }
                return false;
            }).ToList();
        }

        _currentPage = 1;
        UpdatePagination();
    }

    private void SortByColumn(string propertyName)
    {
        if (!AllowSorting) return;

        if (_sortColumn == propertyName)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = propertyName;
            _sortAscending = true;
        }

        var prop = _properties.FirstOrDefault(p => p.Name == propertyName);
        if (prop == null) return;

        _filteredData = _sortAscending
            ? _filteredData.OrderBy(x => prop.GetValue(x)).ToList()
            : _filteredData.OrderByDescending(x => prop.GetValue(x)).ToList();

        UpdatePagination();
    }

    private void UpdatePagination()
    {
        _totalItems = _filteredData.Count();
        _totalPages = _totalItems > 0 ? (int)Math.Ceiling(_totalItems / (double)PageSize) : 1;

        if (_currentPage > _totalPages)
            _currentPage = _totalPages > 0 ? _totalPages : 1;

        _pagedData = _filteredData
            .Skip((_currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

        StateHasChanged();
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        UpdatePagination();
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newSize))
        {
            PageSize = newSize;
            _currentPage = 1;
            UpdatePagination();
        }
    }

    private IEnumerable<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var maxPagesToShow = 5;
        var halfRange = maxPagesToShow / 2;

        var start = Math.Max(1, _currentPage - halfRange);
        var end = Math.Min(_totalPages, _currentPage + halfRange);

        if (_currentPage <= halfRange)
            end = Math.Min(_totalPages, maxPagesToShow);
        else if (_currentPage >= _totalPages - halfRange)
            start = Math.Max(1, _totalPages - maxPagesToShow + 1);

        if (start > 1)
        {
            pages.Add(1);
            if (start > 2) pages.Add(-1);
        }

        for (int i = start; i <= end; i++)
            pages.Add(i);

        if (end < _totalPages)
        {
            if (end < _totalPages - 1) pages.Add(-1);
            pages.Add(_totalPages);
        }

        return pages;
    }
}