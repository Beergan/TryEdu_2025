@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly"
            AdditionalAssemblies="@GetAdditionalAssemblies()">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(SLK.TryEdu.WebApp.Components.Layout.AppShellLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(SLK.TryEdu.WebApp.Components.Layout.AppShellLayout)">
                <Error404 />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private Assembly[] GetAdditionalAssemblies()
    {
        return AssembliesUtil.GetBlazorAssemblies().ToArray();
    }
}