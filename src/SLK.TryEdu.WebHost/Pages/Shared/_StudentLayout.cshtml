@using Microsoft.AspNetCore.Http.Extensions
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "TryEdu - Học Tiếng Anh Miễn Phí & Thi Thử Chuyên Nghiệp")</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="@(ViewData["Description"] ?? "TryEdu - Hệ thống giáo dục trực tuyến B2B2C. Học Tiếng Anh miễn phí ngay lập tức. Mua bài thi thử IELTS, TOEIC bằng coin. AI chấm điểm tự động trong 3 giây với độ chính xác 98%.")">
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "học tiếng anh miễn phí, thi thử IELTS, thi thử TOEIC, nạp coin, mã giới thiệu, AI chấm bài, chấm điểm tự động, TryEdu, giáo dục trực tuyến, khóa học miễn phí, bài thi có thu phí")">
    <meta name="author" content="TryEdu AI Team">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

    <!-- Canonical URL -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.GetDisplayUrl())" />

    <!-- Favicon -->
    <link rel="icon" href="@(ViewData["Favicon"] ?? "/favicon.ico")" type="image/x-icon" />
    <link rel="icon" href="@(ViewData["Favicon"] ?? "/favicon.ico")" sizes="32x32">
    <link rel="icon" href="@(ViewData["Favicon"] ?? "/favicon.ico")" sizes="192x192">

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"] ?? "TryEdu AI - Hệ thống thi thử trực tuyến thông minh")">
    <meta property="og:description" content="@(ViewData["OgDescription"] ?? ViewData["Description"] ?? "Hệ thống thi thử trực tuyến tích hợp AI thông minh, chấm điểm tự động và đề xuất lộ trình học tập cá nhân hóa.")">
    <meta property="og:url" content="@(ViewData["OgUrl"] ?? Context.Request.GetDisplayUrl())">
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/images/og-image.jpg")">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="TryEdu AI">
    <meta property="og:locale" content="vi_VN">

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@(ViewData["TwitterTitle"] ?? ViewData["Title"] ?? "TryEdu AI - Hệ thống thi thử trực tuyến thông minh")">
    <meta name="twitter:description" content="@(ViewData["TwitterDescription"] ?? ViewData["Description"] ?? "Hệ thống thi thử trực tuyến tích hợp AI thông minh, chấm điểm tự động và đề xuất lộ trình học tập cá nhân hóa.")">
    <meta name="twitter:image" content="@(ViewData["TwitterImage"] ?? "/images/twitter-image.jpg")">
    <meta name="twitter:site" content="/">
    <meta name="twitter:creator" content="/">

    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" content="#007bff">
    <meta name="msapplication-TileColor" content="#007bff">
    <meta name="msapplication-TileImage" content="/images/ms-tile-144x144.png">

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "EducationalOrganization",
            "name": "TryEdu AI",
            "alternateName": "TryEdu",
            "url": "@(ViewData["CanonicalUrl"] ?? Context.Request.GetDisplayUrl())",
            "logo": {
                "@@type": "ImageObject",
                "url": "/images/logo.png",
                "width": 200,
                "height": 60
            },
            "description": "Hệ thống giáo dục trực tuyến B2B2C. Khóa học Tiếng Anh miễn phí. Bài thi thử IELTS, TOEIC có thu phí bằng coin. AI chấm điểm tự động với độ chính xác 98%.",
            "foundingDate": "2024",
            "address": {
                "@@type": "PostalAddress",
                "addressCountry": "VN",
                "addressLocality": "Hà Nội",
                "addressRegion": "Hà Nội",
                "streetAddress": "123 Đường ABC, Quận XYZ"
            },
            "contactPoint": {
                "@@type": "ContactPoint",
                "telephone": "+84-123-456-789",
                "email": "support@tryedu.ai",
                "contactType": "customer service",
                "availableLanguage": ["Vietnamese", "English"]
            },
            "sameAs": [
                "https://www.facebook.com/tryeduai",
                "https://www.twitter.com/tryeduai",
                "https://www.linkedin.com/company/tryeduai",
                "https://www.youtube.com/c/tryeduai"
            ],
            "offers": [
                {
                    "@@type": "Offer",
                    "name": "Khóa học Tiếng Anh miễn phí",
                    "description": "Truy cập ngay lập tức các khóa học Tiếng Anh chất lượng cao hoàn toàn miễn phí",
                    "price": "0",
                    "priceCurrency": "VND",
                    "availability": "https://schema.org/InStock"
                },
                {
                    "@@type": "Offer",
                    "name": "Bài thi thử IELTS",
                    "description": "Bài thi thử IELTS đầy đủ 4 kỹ năng, AI chấm điểm tự động",
                    "price": "300",
                    "priceCurrency": "COIN",
                    "availability": "https://schema.org/InStock"
                },
                {
                    "@@type": "Offer",
                    "name": "Bài thi thử TOEIC",
                    "description": "Bài thi thử TOEIC Listening & Reading, AI chấm điểm tự động",
                    "price": "200",
                    "priceCurrency": "COIN",
                    "availability": "https://schema.org/InStock"
                }
            ],
            "hasOfferCatalog": {
                "@@type": "OfferCatalog",
                "name": "Danh mục khóa học và bài thi",
                "itemListElement": [
                    {
                        "@@type": "Offer",
                        "itemOffered": {
                            "@@type": "Course",
                            "name": "Khóa học Tiếng Anh miễn phí",
                            "description": "Khóa học Tiếng Anh chất lượng cao, truy cập miễn phí ngay lập tức"
                        }
                    },
                    {
                        "@@type": "Offer",
                        "itemOffered": {
                            "@@type": "Course",
                            "name": "Bài thi thử IELTS",
                            "description": "Bài thi thử IELTS đầy đủ 4 kỹ năng, mua bằng coin"
                        }
                    },
                    {
                        "@@type": "Offer",
                        "itemOffered": {
                            "@@type": "Course",
                            "name": "Bài thi thử TOEIC",
                            "description": "Bài thi thử TOEIC Listening & Reading, mua bằng coin"
                        }
                    }
                ]
            }
        }
    </script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'GA_MEASUREMENT_ID', {
            'page_title': '@(ViewData["Title"] ?? "TryEdu AI")',
            'page_location': '@Context.Request.GetDisplayUrl()'
        });
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/css/student.css" rel="stylesheet" />
    <link href="~/css/register.css" rel="stylesheet" />
</head>
<body>
    <!-- Navigation -->
    @await Html.PartialAsync("_Header")
    <main>
        @RenderBody()
    </main>
    @await Html.PartialAsync("_Footer")
    <script src="~/assets/jquery/jquery-3.5.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/student.js"></script>
    <script>
       
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>