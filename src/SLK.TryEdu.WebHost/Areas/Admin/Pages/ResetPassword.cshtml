@page "/admin/reset-password/{value?}"
@model SLK.TryEdu.WebHost.Areas.Admin.Pages.ResetPassword
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Try Edu - Đặt lại mật khẩu</title>
    <link rel="stylesheet" href="~/assets/bootstrap/4.5.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/font-awesome/5.15.1/css/all.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-container {
            width: 100%;
            max-width: 500px;
        }

        .reset-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: slideUp 0.5s ease-out;
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card-header-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 30px;
            text-align: center;
            color: white;
        }

            .card-header-custom img {
                height: 50px;
                margin-bottom: 15px;
                filter: brightness(0) invert(1);
            }

            .card-header-custom h5 {
                margin: 0;
                font-size: 22px;
                font-weight: 700;
            }

        /* Step Indicator */
        .step-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 30px 20px;
            gap: 10px;
        }

        .step-item {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #a0aec0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.3s ease;
            position: relative;
        }

            .step-item.active {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                color: white;
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
            }

            .step-item.completed {
                background: #48bb78;
                color: white;
            }

                .step-item.completed::after {
                    content: "✓";
                    position: absolute;
                }

        .step-line {
            width: 60px;
            height: 3px;
            background: #e2e8f0;
            transition: all 0.3s ease;
        }

            .step-line.active {
                background: linear-gradient(90deg, #48bb78 0%, #667eea 100%);
            }

        .card-body-custom {
            padding: 0 30px 40px;
        }

        /* Step Content */
        .step {
            display: none;
            animation: fadeIn 0.4s ease-out;
        }

            .step.active {
                display: block;
            }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateX(20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }

        .form-group {
            margin-bottom: 24px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #2d3748;
                font-size: 14px;
            }

                .form-group label i {
                    margin-right: 6px;
                    color: #667eea;
                }

        .form-control {
            height: 50px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 15px;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                outline: none;
            }

            .form-control::placeholder {
                color: #a0aec0;
            }

        .otp-info {
            background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
            border: 2px dashed #667eea;
            border-radius: 12px;
            padding: 20px;
            margin-top: 12px;
            text-align: center;
        }

        .otp-info-icon {
            font-size: 32px;
            margin-bottom: 10px;
        }

        .otp-info small {
            display: block;
            color: #4a5568;
            margin-bottom: 12px;
            font-size: 13px;
            line-height: 1.6;
        }

        .countdown-timer {
            color: #667eea;
            font-weight: 700;
            font-size: 28px;
            font-family: "Courier New", monospace;
            letter-spacing: 3px;
            display: inline-block;
            padding: 8px 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .otp-expired {
            color: #e53e3e;
            font-weight: 700;
            font-size: 16px;
        }

        .password-requirements {
            background: #f7fafc;
            border-left: 3px solid #667eea;
            padding: 12px 14px;
            margin-top: 8px;
            border-radius: 6px;
        }

            .password-requirements small {
                color: #4a5568;
                font-size: 12px;
                line-height: 1.8;
                display: block;
            }

        .text-danger {
            display: block;
            color: #e53e3e;
            font-size: 13px;
            margin-top: 6px;
            font-weight: 500;
        }

        .alert {
            border-radius: 10px;
            border: none;
            padding: 14px 16px;
            margin-bottom: 20px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .alert i {
                font-size: 18px;
            }

        .alert-danger {
            background: #fff5f5;
            color: #c53030;
            border-left: 4px solid #fc8181;
        }

        .alert-success {
            background: #f0fff4;
            color: #22543d;
            border-left: 4px solid #68d391;
        }

        .btn-submit {
            width: 100%;
            height: 52px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-submit:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
            }

            .btn-submit:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-submit:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }

        .btn-resend {
            background: white;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 12px 24px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
        }

            .btn-resend:hover:not(:disabled) {
                background: #667eea;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
            }

            .btn-resend:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .spinner-border-sm {
            width: 18px;
            height: 18px;
            border-width: 2px;
        }

        .d-none {
            display: none !important;
        }

        .success-checkmark {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: scaleIn 0.5s ease-out;
        }

            .success-checkmark i {
                color: white;
                font-size: 32px;
            }

        @@keyframes scaleIn {
            from

        {
            transform: scale(0);
        }

        to {
            transform: scale(1);
        }

        }

       @@media (max-width: 576px) {
            .card-header-custom

        {
            padding: 25px 20px;
        }

        .step-indicator {
            padding: 25px 20px 15px;
        }

        .card-body-custom {
            padding: 0 20px 30px;
        }

        .card-header-custom h5 {
            font-size: 20px;
        }

        .countdown-timer {
            font-size: 24px;
        }

        }

        .input-with-toggle {
            position: relative;
        }

            .input-with-toggle input[type="password"],
            .input-with-toggle input[type="text"] {
                padding-right: 3.2rem; 
            }

        .toggle-visibility {
            position: absolute;
            right: 0.5rem;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            padding: 0.25rem 0.45rem;
            cursor: pointer;
            font-size: 1.05rem;
            color: #6c757d;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

            .toggle-visibility:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(0,123,255,0.15);
                border-radius: 4px;
            }
    </style>
</head>
<body>
    @if (Model.IsCheckUserId)
    {
        <div class="reset-container">
            <div class="reset-card">
                <div class="card-header-custom">
                    <img src="/assets/images/logo-mains.png" alt="Try Edu Logo">
                    <h5>🔐 Đặt lại mật khẩu</h5>
                </div>
                <div class="step-indicator">
                    <div class="step-item active" id="step1-indicator">1</div>
                    <div class="step-line" id="step-line"></div>
                    <div class="step-item" id="step2-indicator">2</div>
                </div>
                <div class="card-body-custom">
                    <form id="resetPasswordForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="hiddenUserId" value="@Model.UserId" />
                        <div class="step active" id="step1">
                            <div id="generalError" class="alert alert-danger d-none" role="alert">
                                <i class="fas fa-exclamation-circle"></i>
                                <span id="generalErrorText"></span>
                            </div>
                            <div class="form-group">
                                <label><i class="fas fa-key"></i> Mã OTP</label>
                                <input id="otp" placeholder="Nhập mã OTP 6 số" type="text" class="form-control" maxlength="6" autocomplete="off">
                                <span id="otpError" class="text-danger"></span>
                                <div class="otp-info">
                                    <div class="otp-info-icon">📧</div>
                                    <small>Mã OTP đã được gửi đến email của bạn<br>Vui lòng kiểm tra hộp thư đến hoặc spam</small>
                                    <div>
                                        <span class="countdown-timer" id="countdownInfo">01:00</span>
                                    </div>
                                </div>
                                <div id="resendContainer" style="text-align: center;"></div>
                            </div>
                            <button id="btnVerifyOtp" class="btn-submit" type="button">
                                <span id="btnVerifyText">Xác thực OTP</span>
                                <span id="btnVerifySpinner" class="spinner-border spinner-border-sm d-none"></span>
                            </button>
                        </div>
                        <div class="step" id="step2">
                            <div class="alert alert-success" role="alert" style="margin-bottom: 24px;">
                                <i class="fas fa-check-circle"></i>
                                <span>Xác thực OTP thành công! Vui lòng nhập mật khẩu mới.</span>
                            </div>
                            <div id="passwordGeneralError" class="alert alert-danger d-none" role="alert">
                                <i class="fas fa-exclamation-circle"></i>
                                <span id="passwordGeneralErrorText"></span>
                            </div>
                            <div class="form-group">
                                <label><i class="fas fa-lock" style="position:relative"></i> Mật khẩu mới</label>
                                <div class="input-wrapper" style="position:relative">
                                    <input id="password" placeholder="Nhập mật khẩu mới" type="password" class="form-control" autocomplete="new-password">
                                    <i class="fas fa-eye toggle-password" style="position:absolute; right:10px; transform:translate(-50%,-50%);top:50%;" data-target="password"></i>
                                </div>
                                <span id="passwordError" class="text-danger"></span>
                                <div class="password-requirements">
                                    <small>
                                        ✓ Độ dài: 8-15 ký tự<br>
                                        ✓ Bao gồm: Chữ hoa, chữ thường, số và ký tự đặc biệt
                                    </small>
                                </div>
                            </div>
                            <div class="form-group">
                                <label><i class="fas fa-lock"></i> Xác nhận mật khẩu</label>
                                <div class="input-wrapper" style="position:relative">
                                    <input id="passwordConfirm" placeholder="Nhập lại mật khẩu mới" type="password" class="form-control" autocomplete="new-password">
                                    <i class="fas fa-eye toggle-password" style="position:absolute; right:10px; transform:translate(-50%,-50%);top:50%;" data-target="passwordConfirm"></i>
                                </div>
                                <span id="passwordConfirmError" class="text-danger"></span>
                            </div>
                            <button id="btnResetPassword" class="btn-submit" type="button">
                                <span id="btnResetText">Đặt lại mật khẩu</span>
                                <span id="btnResetSpinner" class="spinner-border spinner-border-sm d-none"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }else
    {
        <div class="container py-5">
            <div class="card card-404 mx-auto shadow-none">
                <div class="row g-0 align-items-center">
                    <div class="col-md-6 p-4 p-md-5">
                        <div class="d-flex align-items-center mb-3">
                            <div class="big-number me-3">404</div>
                            <div>
                                <h3 class="mb-1">Trang không tìm thấy</h3>
                                <p class="mb-0 muted-text">Trang bạn đang cố truy cập có thể đã được chuyển, đổi tên hoặc không tồn tại.</p>
                            </div>
                        </div>
                        <p class="mt-3">Bạn có thể quay về trang chủ hoặc thử tìm kiếm nội dung bạn cần:</p>
                        <hr class="my-4">

                    </div>


                    <div class="col-md-6 d-flex justify-content-center p-4 p-md-5">
                        <svg class="illustration" viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="404 illustration">
                            <defs>
                                <linearGradient id="g1" x1="0" x2="1">
                                    <stop offset="0" stop-color="#e7f0ff" />
                                    <stop offset="1" stop-color="#f3eefe" />
                                </linearGradient>
                            </defs>
                            <rect x="0" y="0" width="600" height="400" rx="20" fill="url(#g1)" />
                            <g transform="translate(120,60)">
                                <rect x="0" y="0" width="260" height="200" rx="16" fill="#fff" class="shadow-soft" />
                                <circle cx="60" cy="80" r="14" fill="#0d6efd" />
                                <circle cx="200" cy="80" r="14" fill="#6610f2" />
                                <rect x="30" y="130" width="200" height="18" rx="9" fill="#f1f3f5" />
                                <text x="130" y="95" text-anchor="middle" font-size="48" font-weight="700" fill="#8a8f95">:(</text>
                            </g>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/assets/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/assets/bootstrap/4.5.3/js/bootstrap.bundle.min.js"></script>
    <script>
        let countdownTimer;
        let timeLeft = 60; 
        let isOtpExpired = false;
        let isOtpVerified = false;

        $(document).ready(function() {
            initializeTimerState();
            startCountdown();

            // Xác thực OTP
            $('#btnVerifyOtp').on('click', function() {
                verifyOtp();
            });

            // Đặt lại mật khẩu
            $('#btnResetPassword').on('click', function() {
                resetPassword();
            });

            // Chỉ cho phép nhập số vào OTP
            $('#otp').on('keypress', function(e) {
                return (e.which >= 48 && e.which <= 57);
            });

            // Enter để submit
            $('#otp').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    verifyOtp();
                }
            });

            $('#password, #passwordConfirm').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    resetPassword();
                }
            });
        });

        function initializeTimerState() {
            const storedTimerState = localStorage.getItem('otpTimerState');
            const userId = $('#hiddenUserId').val();

            if (storedTimerState) {
                const { userId: storedUserId, expiryTime } = JSON.parse(storedTimerState);

                if (storedUserId === userId) {
                    const now = Date.now();
                    const timeRemaining = Math.floor((expiryTime - now) / 1000);

                    if (timeRemaining > 0) {
                        timeLeft = timeRemaining;
                        isOtpExpired = false;
                    } else {
                        timeLeft = 0;
                        isOtpExpired = true;
                    }
                } else {
                    localStorage.removeItem('otpTimerState');
                    timeLeft = 60;
                    isOtpExpired = false;
                }
            } else {
                timeLeft = 60;
                isOtpExpired = false;
                saveTimerState();
            }
        }

        function saveTimerState() {
            const userId = $('#hiddenUserId').val();
            const expiryTime = Date.now() + timeLeft * 1000;
            localStorage.setItem('otpTimerState', JSON.stringify({
                userId,
                expiryTime
            }));
        }

        function clearTimerState() {
            localStorage.removeItem('otpTimerState');
        }

        function verifyOtp() {
            $('#otpError, #generalErrorText').text('');
            $('#generalError').addClass('d-none');

            var userId = $('#hiddenUserId').val();
            var otp = $('#otp').val().trim();

            if (!otp) {
                $('#otpError').text('⚠️ Vui lòng nhập mã OTP!');
                $('#otp').focus();
                return;
            }

            if (otp.length !== 6) {
                $('#otpError').text('⚠️ Mã OTP phải có 6 số!');
                $('#otp').focus();
                return;
            }

            $('#btnVerifyText').text('Đang xác thực');
            $('#btnVerifySpinner').removeClass('d-none');
            $('#btnVerifyOtp').prop('disabled', true);

            $.ajax({
                url: '/admin/reset-password?handler=VerifyOtp',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({
                    userId: userId,
                    otp: otp
                }),
                success: function(response) {
                    if (response.success) {
                        isOtpVerified = true;
                        clearInterval(countdownTimer);
                        clearTimerState();
                        showStep2();
                    } else {
                        $('#generalErrorText').text(response.message);
                        $('#generalError').removeClass('d-none');
                    }
                },
                error: function() {
                    $('#generalErrorText').text('Đã có lỗi xảy ra! Vui lòng thử lại.');
                    $('#generalError').removeClass('d-none');
                },
                complete: function() {
                    $('#btnVerifyText').text('Xác thực OTP');
                    $('#btnVerifySpinner').addClass('d-none');
                    $('#btnVerifyOtp').prop('disabled', false);
                }
            });
        }

        function resetPassword() {
            $('#passwordError, #passwordConfirmError, #passwordGeneralErrorText').text('');
            $('#passwordGeneralError').addClass('d-none');

            var userId = $('#hiddenUserId').val();
            var otp = $('#otp').val().trim();
            var password = $('#password').val();
            var passwordConfirm = $('#passwordConfirm').val();

            if (!password) {
                $('#passwordError').text('⚠️ Vui lòng nhập mật khẩu mới!');
                $('#password').focus();
                return;
            }

            if (!passwordConfirm) {
                $('#passwordConfirmError').text('⚠️ Vui lòng xác nhận mật khẩu!');
                $('#passwordConfirm').focus();
                return;
            }

            if (password !== passwordConfirm) {
                $('#passwordConfirmError').text('⚠️ Xác nhận mật khẩu không khớp!');
                $('#passwordConfirm').focus();
                return;
            }

            $('#btnResetText').text('Đang xử lý');
            $('#btnResetSpinner').removeClass('d-none');
            $('#btnResetPassword').prop('disabled', true);

            $.ajax({
                url: '/admin/reset-password?handler=ResetPasswordWithOtp',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({
                    userId: userId,
                    otp: otp,
                    password: password,
                    passwordConfirm: passwordConfirm
                }),
                success: function(response) {
                    if (response.success) {
                        clearTimerState();
                        showSuccessAndRedirect();
                    } else {
                        $('#passwordGeneralErrorText').text(response.message);
                        $('#passwordGeneralError').removeClass('d-none');
                    }
                },
                error: function() {
                    $('#passwordGeneralErrorText').text('Đã có lỗi xảy ra! Vui lòng thử lại.');
                    $('#passwordGeneralError').removeClass('d-none');
                },
                complete: function() {
                    $('#btnResetText').text('Đặt lại mật khẩu');
                    $('#btnResetSpinner').addClass('d-none');
                    $('#btnResetPassword').prop('disabled', false);
                }
            });
        }

        function showStep2() {
            $('#step1').removeClass('active');
            $('#step2').addClass('active');
            $('#step1-indicator').removeClass('active').addClass('completed');
            $('#step2-indicator').addClass('active');
            $('#step-line').addClass('active');
            $('#password').focus();
        }

        function showSuccessAndRedirect() {
            $('#step2').html(`
                <div style="text-align: center; padding: 20px 0;">
                    <div class="success-checkmark">
                        <i class="fas fa-check"></i>
                    </div>
                    <h4 style="color: #2d3748; margin-bottom: 12px; font-size: 20px;">Thành công!</h4>
                    <p style="color: #718096; font-size: 15px;">Mật khẩu của bạn đã được đặt lại.<br>Đang chuyển hướng...</p>
                </div>
            `);

            setTimeout(function() {
                window.location.href = '/admin';
            }, 800);
        }

        function startCountdown() {
            console.log('Starting countdown...');
            updateCountdownDisplay();

            if (countdownTimer) {
                clearInterval(countdownTimer);
            }

            countdownTimer = setInterval(function() {
                if (isOtpVerified) {
                    console.log('OTP verified, stopping countdown');
                    clearInterval(countdownTimer);
                    clearTimerState();
                    return;
                }

                timeLeft--;
                console.log('Time left:', timeLeft);
                saveTimerState();
                updateCountdownDisplay();

                if (timeLeft <= 0) {
                    console.log('Time expired!');
                    clearInterval(countdownTimer);
                    isOtpExpired = true;
                    saveTimerState();
                    showResendButton();
                }
            }, 1000);
        }

        function updateCountdownDisplay() {
            if (isOtpExpired || isOtpVerified) {
                console.log('Skip update - expired or verified');
                return;
            }

            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            const displayTime = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

            console.log('Updating display:', displayTime);
            $('#countdownInfo').text(displayTime);

            if (timeLeft <= 60) {
                $('#countdownInfo').css('color', '#e53e3e');
            } else {
                $('#countdownInfo').css('color', '#667eea');
            }
        }

        function showResendButton() {
            $('#countdownInfo').html('<span class="otp-expired">⏰ Mã OTP đã hết hạn!</span>');
            $('#resendContainer').html(`
                <button type="button" class="btn-resend" id="resendOtpBtn">
                    <i class="fas fa-redo"></i>
                    <span>Gửi lại mã OTP</span>
                </button>
            `);

            $('#resendOtpBtn').on('click', function() {
                var userId = $('#hiddenUserId').val();
                if (!userId) return;

                var $btn = $(this);
                $btn.html('<span class="spinner-border spinner-border-sm"></span> Đang gửi...').prop('disabled', true);

                $.ajax({
                    url: '/admin/forgot-password?handler=SendOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ userId: userId }),
                    success: function(response) {
                        if (response.success) {
                            $('#generalError').removeClass('d-none')
                                .removeClass('alert-danger')
                                .addClass('alert-success')
                                .find('span').text('✓ Mã OTP mới đã được gửi!');

                            $('#resendContainer').empty();
                            timeLeft = 60; 
                            isOtpExpired = false;
                            saveTimerState();
                            startCountdown();

                            setTimeout(function() {
                                $('#generalError').addClass('d-none')
                                    .removeClass('alert-success')
                                    .addClass('alert-danger');
                            }, 600);
                        } else {
                            $('#generalErrorText').text(response.message);
                            $('#generalError').removeClass('d-none');
                        }
                    },
                    error: function() {
                        $('#generalErrorText').text('Đã có lỗi xảy ra khi gửi lại OTP!');
                        $('#generalError').removeClass('d-none');
                    },
                    complete: function() {
                        $btn.html('<i class="fas fa-redo"></i> <span>Gửi lại mã OTP</span>').prop('disabled', false);
                    }
                });
            });
        }

        document.querySelectorAll('.toggle-password').forEach(icon => {
            icon.addEventListener('click', () => {
                const targetId = icon.getAttribute('data-target');
                const input = document.getElementById(targetId);
                if (!input) return;

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        });
    </script>
