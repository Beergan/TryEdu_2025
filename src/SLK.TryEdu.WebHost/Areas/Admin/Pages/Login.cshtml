@page "admin/login"
@model SLK.TryEdu.WebHost.Areas.Admin.Pages.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Security.Claims;
@using Microsoft.AspNetCore.Authentication;
@using SLK.TryEdu.WebHost.Areas.Admin.Pages
@{

    if (User.Identity?.IsAuthenticated == true)
    {
        Response.Redirect("/admin");
        return;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>TryEdu [v@(SLK.TryEdu.WebHost.AutoClass.FullVersion) @SLK.TryEdu.WebHost.AutoClass.BuildName] - Hệ thống quản lý thi thử</title>
    <meta name="description" content="TryEdu - Hệ thống quản lý thi thử dành cho giáo viên và quản trị viên">
    <meta name="keywords" content="he thong quan ly thi thu, giao vien, quan tri vien, e-learning, exam management">
    <meta property="og:title" content="TryEdu - Hệ thống quản lý thi thử" />
    <meta property="og:image" content="~/assets/images/logo-mains.png" />
    <meta property="og:description" content="TryEdu - Hệ thống quản lý thi thử dành cho giáo viên và quản trị viên" />
    <base href="/" />
    <link rel="icon" href="~/assets/images/favicon-ileadernext.png" />
    <link rel="mask-icon" href="~/assets/images/favicon-ileadernext.png" />
    <link rel="icon" sizes="16x16" href="~/assets/images/favicon-ileadernext.png" />
    <link rel="icon" sizes="192x192" href="~/assets/images/favicon-ileadernext.png" />
    <link rel="stylesheet" href="assets/bootstrap/4.5.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="assets/font-awesome/5.15.1/css/all.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

            /* Animated background */
            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1) 0%, transparent 50%);
                animation: backgroundShift 15s ease infinite;
            }

        @@keyframes backgroundShift {
            0%, 100%
        {
            opacity: 0.3;
        }

        50% {
            opacity: 0.6;
        }

        }

        .container-fluid {
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
        }

        #container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 900px;
            width: 90%;
            min-height: 550px;
            display: flex;
            position: relative;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .form-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 60px;
            transition: all 0.6s ease;
        }

            .form-container form {
                width: 100%;
                max-width: 380px;
            }

            .form-container h3 {
                color: #1a1a2e;
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 12px;
                letter-spacing: -0.5px;
            }

            .form-container p {
                color: #6b7280;
                font-size: 14px;
                margin-bottom: 35px;
                line-height: 1.6;
            }

            .form-container input {
                width: 100%;
                padding: 14px 18px;
                margin: 12px 0;
                border: 2px solid #e5e7eb;
                border-radius: 12px;
                font-size: 15px;
                transition: all 0.3s ease;
                background: #f9fafb;
                color: #1f2937;
            }

                .form-container input:focus {
                    outline: none;
                    border-color: #667eea;
                    background: white;
                    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                }

                .form-container input::placeholder {
                    color: #9ca3af;
                }

        .text-danger {
            display: block;
            color: #ef4444;
            font-size: 13px;
            margin: 8px 0;
            font-weight: 500;
        }

        .fp {
            display: inline-block;
            color: #667eea;
            font-size: 14px;
            text-decoration: none;
            margin: 15px 0;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .fp:hover {
                color: #764ba2;
                text-decoration: none;
            }

        .form-container button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

            .form-container button:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
            }

            .form-container button:active {
                transform: translateY(0);
            }

        .social-icons {
            margin-top: 30px;
            padding-top: 25px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            color: #9ca3af;
            font-size: 13px;
        }

            .social-icons center {
                margin: 6px 0;
            }

        .toggle-container {
            flex: 1;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px;
            position: relative;
            overflow: hidden;
        }

            .toggle-container::before {
                content: '';
                position: absolute;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
                animation: rotate 20s linear infinite;
            }

        @@keyframes rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .toggle-panel {
            text-align: center;
            color: white;
            position: relative;
            z-index: 1;
        }

            .toggle-panel h3 {
                font-size: 26px;
                font-weight: 700;
                margin-bottom: 16px;
                letter-spacing: -0.5px;
            }

            .toggle-panel p {
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 30px;
                color: rgba(255, 255, 255, 0.85);
            }

            .toggle-panel img {
                max-width: 180px;
                height: auto;
                filter: brightness(0) invert(1);
                animation: float 3s ease-in-out infinite;
            }

        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }

        }

        /* Mobile styles */
        @@media (max-width: 768px) {
            #container

        {
            flex-direction: column;
            width: 95%;
            min-height: auto;
        }

        .form-container {
            padding: 40px 30px;
        }

        .toggle-container {
            display: none;
        }

        .form-container h3 {
            font-size: 24px;
        }

        }

        /* Language selector styles */
        .nav-item-tab {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .dropdown-menu {
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
            padding: 8px;
        }

        .dropdown-item {
            border-radius: 8px;
            padding: 10px 15px;
            transition: all 0.2s ease;
        }

            .dropdown-item:hover {
                background: #f3f4f6;
            }

        .image-nation {
            width: 24px;
            height: 24px;
            margin-right: 8px;
            border-radius: 4px;
        }

        .icon-language {
            color: white;
            font-size: 20px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

            .icon-language:hover {
                transform: scale(1.1);
            }
    </style>
</head>

<body>
    <div class="container-fluid">
        <div class="row" style="width: 100%;">
            <div class="col-12">
                <div class="container" id="container">
                    <div class="form-container sign-in">
                        <form method="post">
                            <h3>Đăng nhập</h3>
                            <p>Chào mừng trở lại! Vui lòng đăng nhập vào tài khoản của bạn.</p>
                            <input name="UserId" placeholder="@Model.Text["User name", "Tên tài khoản"]" type="text" autocomplete="username">
                            <input name="Password" placeholder="@Model.Text["Password", "Mật khẩu"]" type="password" autocomplete="current-password">
                            <small class="text-danger">@Html.ValidationMessage("error")</small>
                            <a href="admin/forgot-password" class="fp">@Model.Text["Forgot password", "Quên mật khẩu"]?</a>
                            <button type="submit">@Model.Text["Login", "Đăng nhập"]</button>
                            <div class="social-icons">
                                <center>&copy; @DateTime.Now.Date.Year TryEdu. All rights reserved.</center>
                                <center>@Model.Text["Version", "Phiên bản"] @SLK.TryEdu.WebHost.AutoClass.FullVersion @SLK.TryEdu.WebHost.AutoClass.BuildName</center>
                            </div>
                        </form>
                    </div>
                    <div class="toggle-container d-none d-md-flex">
                        <div class="toggle-panel toggle-right">
                            <h3>@Model.Text["Hello, Teacher/Admin!", "Xin chào, Giáo viên/Quản trị!"]</h3>
                            <p>
                                @Model.Text["Enter your personal information to access the exam management system.", "Nhập thông tin cá nhân của bạn để truy cập hệ thống quản lý thi thử."]
                            </p>
                            <img src="/assets/images/logo-mains.png" alt="TryEdu Logo">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="assets/jquery/jquery-3.5.1.min.js"></script>
    <script src="assets/bootstrap/4.5.3/js/bootstrap.bundle.min.js"></script>
    <script type="text/javascript" src="assets/app.js"></script>
</body>

</html>