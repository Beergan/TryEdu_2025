@page "/admin/forgot-password/{value?}"
@model SLK.TryEdu.WebHost.Areas.Admin.Pages.ForgotPassword
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Try Edu - Quên mật khẩu</title>
    <link rel="icon" href="~/assets/images/favicon-ileadernext.png" />
    <link rel="stylesheet" href="~/assets/bootstrap/4.5.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/font-awesome/5.15.1/css/all.css" />
    <style>
      

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
        }

        

        @@keyframes float {
            0%, 100%

        {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(50px, 50px) scale(1.1);
        }

        }
        .forgot-container {
            width: 100%;
            max-width: 450px;
            position: relative;
            z-index: 1;
        }
        .forgot-card {
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            animation: slideUp 0.6s ease-out;
        }

        @@keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card-header-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 40px 30px;
            text-align: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .card-header-custom::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
                animation: pulse 3s ease-in-out infinite;
            }

        @@keyframes pulse {
            0%, 100%

        {
            transform: scale(1);
            opacity: 0.5;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.8;
        }

        }

        .card-header-custom img {
            height: 55px;
            margin-bottom: 20px;
            filter: brightness(0) invert(1);
            position: relative;
            z-index: 1;
        }

        .card-header-custom h5 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            letter-spacing: -0.5px;
            position: relative;
            z-index: 1;
        }

        .card-header-custom p {
            margin: 10px 0 0 0;
            font-size: 14px;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }

        .card-body-custom {
            padding: 40px 35px;
        }

        .info-box {
            background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%);
            border-left: 4px solid #667eea;
            border-radius: 12px;
            padding: 16px 20px;
            margin-bottom: 30px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideIn 0.8s ease-out 0.2s both;
        }

        @@keyframes slideIn {
            from

        {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }

        }

        .info-box i {
            color: #667eea;
            font-size: 20px;
            margin-top: 2px;
            flex-shrink: 0;
        }

        .info-box-content {
            flex: 1;
        }

            .info-box-content strong {
                display: block;
                color: #4c51bf;
                margin-bottom: 4px;
                font-size: 14px;
            }

            .info-box-content span {
                color: #5a67d8;
                font-size: 13px;
                line-height: 1.6;
            }

        .form-group {
            margin-bottom: 24px;
        }

            .form-group label {
                display: block;
                margin-bottom: 10px;
                font-weight: 600;
                color: #2d3748;
                font-size: 14px;
            }

                .form-group label i {
                    margin-right: 8px;
                    color: #667eea;
                }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 18px;
            transition: color 0.3s ease;
        }

        .form-control {
            height: 54px;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 14px 16px 14px 48px;
            font-size: 15px;
            transition: all 0.3s ease;
            width: 100%;
        }

            .form-control:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                outline: none;
            }

                .form-control:focus + .input-icon {
                    color: #667eea;
                }

            .form-control::placeholder {
                color: #cbd5e0;
            }

        .text-danger,
        .text-success {
            display: block;
            font-size: 13px;
            margin-top: 8px;
            font-weight: 500;
            animation: fadeIn 0.3s ease-out;
        }

        .text-danger {
            color: #e53e3e;
        }

        .text-success {
            color: #38a169;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .btn-submit {
            width: 100%;
            height: 54px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

            .btn-submit::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                transition: left 0.5s ease;
            }

            .btn-submit:hover:not(:disabled)::before {
                left: 100%;
            }

            .btn-submit:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 12px 28px rgba(102, 126, 234, 0.4);
            }

            .btn-submit:active:not(:disabled) {
                transform: translateY(0);
            }

            .btn-submit:disabled {
                opacity: 0.7;
                cursor: not-allowed;
            }

            .btn-submit i {
                font-size: 18px;
            }

        .spinner-border-sm {
            width: 18px;
            height: 18px;
            border-width: 2px;
        }

        .d-none {
            display: none !important;
        }

        .back-to-login {
            text-align: center;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid #e2e8f0;
        }

            .back-to-login a {
                color: #667eea;
                text-decoration: none;
                font-weight: 600;
                font-size: 14px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.3s ease;
            }

                .back-to-login a:hover {
                    color: #764ba2;
                    gap: 10px;
                }

                .back-to-login a i {
                    font-size: 16px;
                }

        /* Alert styling */
        .alert {
            border-radius: 10px;
            border: none;
            padding: 14px 18px;
            margin-bottom: 20px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideDown 0.4s ease-out;
        }

        @@keyframes slideDown {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .alert i {
            font-size: 18px;
        }

        .alert-info {
            background: #e6f7ff;
            color: #0c5389;
            border-left: 4px solid #1890ff;
        }

        @@media (max-width: 576px) {
            .card-header-custom

        {
            padding: 30px 20px;
        }

        .card-body-custom {
            padding: 30px 20px;
        }

        .card-header-custom h5 {
            font-size: 20px;
        }

        .card-header-custom img {
            height: 45px;
        }

        }

        /* Loading state animation */
        @@keyframes spin {
            to

        {
            transform: rotate(360deg);
        }

        }
    </style>
</head>
<body class="container-fluid">
    <div class="forgot-container">
        <div class="forgot-card">
            <div class="card-header-custom">
                <img src="/assets/images/logo-mains.png" alt="Try Edu Logo">
                <h5>🔑 Quên mật khẩu</h5>
                <p>Nhập tên đăng nhập để nhận mã OTP</p>
            </div>

            <div class="card-body-custom">
                <div class="info-box">
                    <i class="fas fa-info-circle"></i>
                    <div class="info-box-content">
                        <strong>Hướng dẫn:</strong>
                        <span>Nhập tên đăng nhập của bạn. Chúng tôi sẽ gửi mã OTP đến email đã đăng ký để xác thực tài khoản.</span>
                    </div>
                </div>

                <form id="forgotPasswordForm">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label><i class="fas fa-user"></i> Tên đăng nhập</label>
                        <div class="input-wrapper">
                            <input id="userId"
                                   name="UserId"
                                   placeholder="Nhập tên đăng nhập của bạn"
                                   type="text"
                                   class="form-control"
                                   autocomplete="username"
                                   autofocus>
                            <i class="fas fa-user input-icon"></i>
                        </div>
                        <span id="errorMessage" class="text-danger"></span>
                        <span id="successMessage" class="text-success"></span>
                    </div>

                    <button id="btnSendOtp" class="btn-submit" type="button">
                        <i class="fas fa-paper-plane"></i>
                        <span id="btnText">Gửi mã OTP</span>
                        <span id="btnSpinner" class="spinner-border spinner-border-sm d-none"></span>
                    </button>

                    <div class="back-to-login">
                        <a href="/admin/login">
                            <i class="fas fa-arrow-left"></i>
                            <span>Quay lại đăng nhập</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/assets/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/assets/bootstrap/4.5.3/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#userId').focus();

            $('#btnSendOtp').on('click', function() {
                sendOtp();
            });

            $('#userId').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    sendOtp();
                }
            });

            function sendOtp() {
                var userId = $('#userId').val().trim();
				console.log('Sending OTP for userId:', userId);
                $('#errorMessage').text('');
                $('#successMessage').text('');

                // Validation
                if (!userId) {
                    $('#errorMessage').html('<i class="fas fa-exclamation-circle"></i> Vui lòng nhập tên đăng nhập!');
                    $('#userId').focus();
                    return;
                }

                if (userId.length < 3) {
                    $('#errorMessage').html('<i class="fas fa-exclamation-circle"></i> Tên đăng nhập phải có ít nhất 3 ký tự!');
                    $('#userId').focus();
                    return;
                }

                // Show loading
                $('#btnText').text('Đang gửi');
                $('#btnSpinner').removeClass('d-none');
                $('#btnSendOtp').prop('disabled', true);
                $('.btn-submit i.fa-paper-plane').hide();

                $.ajax({
                    url: '/admin/forgot-password?handler=SendOtp',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    data: JSON.stringify({ userId: userId }),
                    success: function(response) {
                        if (response.success) {
                            $('#successMessage').html('<i class="fas fa-check-circle"></i> ' + response.message);

                            // Show success animation
                            $('#userId').css('border-color', '#48bb78');

                            // Redirect sau 1 giây
                            setTimeout(function() {
                                console.log('Redirecting to reset password page...');
                                window.location.href = '/admin/reset-password?userid=' + encodeURIComponent(userId);
                            }, 1000);
                        } else {
                            $('#errorMessage').html('<i class="fas fa-exclamation-circle"></i> ' + response.message);
                            $('#userId').css('border-color', '#fc8181');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        $('#errorMessage').html('<i class="fas fa-exclamation-circle"></i> Đã có lỗi xảy ra! Vui lòng thử lại.');
                        $('#userId').css('border-color', '#fc8181');
                    },
                    complete: function() {
                        $('#btnText').text('Gửi mã OTP');
                        $('#btnSpinner').addClass('d-none');
                        $('#btnSendOtp').prop('disabled', false);
                        $('.btn-submit i.fa-paper-plane').show();
                    }
                });
            }

            // Reset border color khi người dùng nhập lại
            $('#userId').on('input', function() {
                $(this).css('border-color', '#e2e8f0');
                $('#errorMessage').text('');
                $('#successMessage').text('');
            });
        });
    </script>
</body>
</html>