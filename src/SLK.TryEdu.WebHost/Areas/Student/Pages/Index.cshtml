                    </ul>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-card text-center" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="feature-icon mx-auto mb-3" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h4 class="fw-bold mb-3">Mã Giới Thiệu</h4>
