@page
@model SLK.TryEdu.WebHost.Areas.Student.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ - TryEdu";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<section class="hero-section">
    <div class="particles" id="particles"></div>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <div class="hero-badge">
                    <i class="fas fa-sparkles me-2"></i>Hệ Thống Thi Thử Trực Tuyến
                </div>
                <h1 class="hero-title">
                    Học Tiếng Anh Miễn Phí<br>
                    <span style="background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Thi Thử Chuyên Nghiệp</span>
                </h1>
                <p class="hero-subtitle">
                    Truy cập ngay các khóa học Tiếng Anh miễn phí. Mua bài thi thử IELTS, TOEIC bằng coin. AI chấm điểm tự động trong 3 giây với độ chính xác 98%.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/student/free-courses" class="btn btn-hero btn-hero-primary">
                        <i class="fas fa-graduation-cap me-2"></i>Học Miễn Phí Ngay
                    </a>
                    <a href="/student/quizzes" class="btn btn-hero btn-hero-secondary">
                        <i class="fas fa-file-alt me-2"></i>Xem Bài Thi Thử
                    </a>
                </div>
                <div class="mt-5">
                    <div class="row g-4">
                        <div class="col-4">
                            <div class="text-white">
                                <h3 class="fw-bold mb-0">@(Model.StudentModel.TotalStudents)+</h3>
                                <small class="opacity-75">Học viên</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-white">
                                <h3 class="fw-bold mb-0">@(Model.StudentModel.TotalExams)+</h3>
                                <small class="opacity-75">Bài thi thử</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="text-white">
                                <h3 class="fw-bold mb-0">98%</h3>
                                <small class="opacity-75">Độ chính xác AI</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="dashboard-preview">
                    <div class="preview-card">
                        <div class="d-flex align-items-center mb-4">
                            <div class="me-3">
                                <i class="fas fa-robot fa-2x" style="color: var(--primary);"></i>
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold">AI Đang Chấm Bài...</h5>
                                <small class="text-muted">Phân tích bài thi Writing & Speaking</small>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small fw-semibold">Phân tích nội dung</span>
                                <span class="small text-primary">95%</span>
                            </div>
                            <div class="loading-bar">
                                <div class="loading-progress" style="width: 95%;"></div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small fw-semibold">Kiểm tra ngữ pháp</span>
                                <span class="small text-success">88%</span>
                            </div>
                            <div class="loading-bar">
                                <div class="loading-progress" style="width: 88%; animation-delay: 0.5s;"></div>
                            </div>
                        </div>
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small fw-semibold">Đánh giá logic</span>
                                <span class="small text-warning">92%</span>
                            </div>
                            <div class="loading-bar">
                                <div class="loading-progress" style="width: 92%; animation-delay: 1s;"></div>
                            </div>
                        </div>
                        <div class="alert alert-success mb-0">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>Kết quả:</strong> Điểm 9.2/10 - Bài làm xuất sắc!
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="features-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Tính Năng Vượt Trội</h2>
            <p class="section-subtitle">Giải pháp toàn diện cho học tập và thi thử trực tuyến</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 1; transform: translateY(0px); transition: 0.6s;">
                    <div class="feature-icon">
                        <i class="fas fa-gift"></i>
                    </div>
                    <h3 class="feature-title">Khóa Học Miễn Phí</h3>
                    <p class="feature-description">
                        Truy cập ngay lập tức các khóa học Tiếng Anh chất lượng cao hoàn toàn miễn phí. Không cần thanh toán, chỉ cần đăng ký tài khoản.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> Video HD chất lượng cao</li>
                        <li><i class="fas fa-check-circle text-success"></i> Tài liệu học tập đầy đủ</li>
                        <li><i class="fas fa-check-circle text-success"></i> Quiz sau mỗi bài học</li>
                        <li><i class="fas fa-check-circle text-success"></i> Học mọi lúc, mọi nơi</li>
                    </ul>
                    <a href="/student/free-courses" class="btn btn-outline-primary mt-3 w-100">
                        <i class="fas fa-arrow-right me-2"></i>Xem Khóa Học Miễn Phí
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 1; transform: translateY(0px); transition: 0.6s;">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <h3 class="feature-title">Bài Thi Thử Có Thu Phí</h3>
                    <p class="feature-description">
                        Mua bài thi thử IELTS, TOEIC bằng coin với giá hợp lý. Chấm điểm tự động bởi AI và giáo viên chuyên nghiệp. Nhận kết quả ngay sau khi làm xong.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> 4 kỹ năng đầy đủ (Reading, Listening, Writing, Speaking)</li>
                        <li><i class="fas fa-check-circle text-success"></i> Chấm điểm trong 3 giây</li>
                        <li><i class="fas fa-check-circle text-success"></i> Feedback chi tiết từ AI và giáo viên</li>
                        <li><i class="fas fa-check-circle text-success"></i> Lưu lịch sử và theo dõi tiến độ</li>
                    </ul>
                    <a href="/student/quizzes" class="btn btn-outline-primary mt-3 w-100">
                        <i class="fas fa-arrow-right me-2"></i>Xem Bài Thi Thử
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 1; transform: translateY(0px); transition: 0.6s;">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <i class="fas fa-coins"></i>
                    </div>
                    <h3 class="feature-title">Hệ Thống Coin</h3>
                    <p class="feature-description">
                        Nạp coin vào tài khoản để mua bài thi thử. Sử dụng mã giới thiệu từ trung tâm đối tác để được giảm giá. Thanh toán nhanh chóng và an toàn.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> Nạp coin dễ dàng (VNPay, MoMo, Banking)</li>
                        <li><i class="fas fa-check-circle text-success"></i> Sử dụng mã giới thiệu để giảm giá</li>
                        <li><i class="fas fa-check-circle text-success"></i> Quản lý ví coin trực quan</li>
                        <li><i class="fas fa-check-circle text-success"></i> Lịch sử giao dịch chi tiết</li>
                    </ul>
                    <a href="/student/coin-wallet" class="btn btn-outline-primary mt-3 w-100">
                        <i class="fas fa-wallet me-2"></i>Nạp Coin Ngay
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #ec4899, #db2777);">
                        <i class="fas fa-robot"></i>
                    </div>
                    <h3 class="feature-title">AI Chấm Điểm Tự Động</h3>
                    <p class="feature-description">
                        Công nghệ AI tiên tiến phân tích và chấm điểm bài thi Writing/Speaking với độ chính xác 98.5%. Nhận kết quả ngay sau khi làm xong.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> Chấm tức thì (< 3 giây)</li>
                        <li><i class="fas fa-check-circle text-success"></i> Phân tích sâu về ngữ pháp, từ vựng</li>
                        <li><i class="fas fa-check-circle text-success"></i> Đề xuất cải thiện cụ thể</li>
                        <li><i class="fas fa-check-circle text-success"></i> So sánh với chuẩn IELTS/TOEIC</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3 class="feature-title">Mã Giới Thiệu</h3>
                    <p class="feature-description">
                        Nhận mã giới thiệu từ trung tâm đối tác để được giảm giá khi nạp coin hoặc mua bài thi. Tiết kiệm chi phí và hỗ trợ trung tâm của bạn.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> Giảm giá khi nạp coin</li>
                        <li><i class="fas fa-check-circle text-success"></i> Giảm giá khi mua bài thi</li>
                        <li><i class="fas fa-check-circle text-success"></i> Validate mã real-time</li>
                        <li><i class="fas fa-check-circle text-success"></i> Lưu lịch sử sử dụng mã</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="feature-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="feature-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3 class="feature-title">Theo Dõi Tiến Độ</h3>
                    <p class="feature-description">
                        Dashboard học tập trực quan với báo cáo chi tiết về điểm số, tiến độ học tập và xu hướng cải thiện qua thời gian.
                    </p>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle text-success"></i> Dashboard trực quan</li>
                        <li><i class="fas fa-check-circle text-success"></i> Lịch sử bài thi chi tiết</li>
                        <li><i class="fas fa-check-circle text-success"></i> Phân tích điểm mạnh/yếu</li>
                        <li><i class="fas fa-check-circle text-success"></i> Dự đoán kết quả thi thật</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section id="process" class="process-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Cách Thức Hoạt Động</h2>
            <p class="section-subtitle">Chỉ 3 bước đơn giản để bắt đầu học và thi thử</p>
        </div>
        <div class="row g-5">
            <div class="col-lg-4">
                <div class="process-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="process-number">1</div>
                    <h3 class="process-title">Đăng Ký & Học Miễn Phí</h3>
                    <p class="process-description">
                        Tạo tài khoản trong 30 giây. Xác thực email và bắt đầu học ngay lập tức với các khóa học Tiếng Anh miễn phí. Không cần thanh toán.
                    </p>
                    <a href="/student/register" class="btn btn-outline-primary mt-3">
                        <i class="fas fa-user-plus me-2"></i>Đăng Ký Ngay
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="process-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="process-number">2</div>
                    <h3 class="process-title">Nạp Coin & Mua Bài Thi</h3>
                    <p class="process-description">
                        Nạp coin vào tài khoản (sử dụng mã giới thiệu để được giảm giá). Mua bài thi thử IELTS, TOEIC bằng coin. Làm bài thi và nhận kết quả AI ngay.
                    </p>
                    <a href="/student/coin-wallet" class="btn btn-outline-primary mt-3">
                        <i class="fas fa-wallet me-2"></i>Nạp Coin
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="process-card" style="opacity: 0; transform: translateY(30px); transition: 0.6s;">
                    <div class="process-number">3</div>
                    <h3 class="process-title">Nhận Kết Quả & Cải Thiện</h3>
                    <p class="process-description">
                        Nhận kết quả chấm điểm tự động từ AI trong 3 giây. Xem feedback chi tiết từ giáo viên. Theo dõi tiến độ và cải thiện điểm số.
                    </p>
                    <a href="/student/dashboard" class="btn btn-outline-primary mt-3">
                        <i class="fas fa-chart-line me-2"></i>Xem Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Coin System Section -->
