@page 
@model SLK.TryEdu.WebHost.Areas.Student.Pages.QuizDetailModel
@{
    ViewData["Title"] = "Chi tiết Trắc nghiệm - TryEdu";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<style>
    .quiz-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px 0;
        border-radius: 0 0 30px 30px;
        margin-bottom: 30px;
    }
    .question-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 24px;
        transition: all 0.3s ease;
    }
    .question-card:hover {
        box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    }
    .answer-option {
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
    }
    .answer-option:hover {
        border-color: #667eea;
        background: #f7faff;
        transform: translateX(4px);
    }
    .answer-option input[type="radio"] {
        width: 20px;
        height: 20px;
        margin-right: 12px;
    }
    .answer-option.selected {
        border-color: #667eea;
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
    }
    .question-nav {
        position: sticky;
        top: 80px;
    }
    .question-nav-item {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        background: white;
    }
    .question-nav-item:hover {
        border-color: #667eea;
        transform: scale(1.1);
    }
    .question-nav-item.answered {
        background: #48bb78;
        color: white;
        border-color: #48bb78;
    }
    .question-nav-item.current {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-color: #667eea;
    }
    .timer-box {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 20px;
    }
    .timer-display {
        font-size: 36px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: #667eea;
        text-align: center;
        letter-spacing: 2px;
    }
    .timer-display.warning {
        color: #ed8936;
    }
    .timer-display.danger {
        color: #f56565;
        animation: pulse 1s infinite;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }
    .progress-stats {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .btn-submit-quiz {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        border: none;
        color: white;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-submit-quiz:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(72, 187, 120, 0.4);
    }
</style>

<div class="quiz-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h2 fw-bold mb-2">📝 Đại số cơ bản</h1>
                <p class="mb-0 opacity-90">
                    <span class="me-3"><i class="fas fa-book-open me-1"></i> Toán học</span>
                    <span class="me-3"><i class="fas fa-question-circle me-1"></i> 20 câu hỏi</span>
                    <span><i class="fas fa-star me-1"></i> Dễ</span>
                </p>
            </div>
            <a href="/student/quizzes" class="btn btn-light">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        <!-- Main Quiz Area -->
        <div class="col-lg-8">
            <!-- Question 1 -->
            <div class="question-card" id="question-1">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold mb-0">
                            <span class="badge bg-primary me-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">Câu 1</span>
                            Giải phương trình: 2x + 5 = 13
                        </h5>
                        <button class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
                            <i class="fas fa-bookmark"></i>
                        </button>
                    </div>

                    <div class="answers">
                        <label class="answer-option">
                            <input type="radio" name="question1" value="A">
                            <span>A. x = 3</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question1" value="B">
                            <span>B. x = 4</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question1" value="C">
                            <span>C. x = 5</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question1" value="D">
                            <span>D. x = 6</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Question 2 -->
            <div class="question-card" id="question-2">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold mb-0">
                            <span class="badge bg-primary me-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">Câu 2</span>
                            Tìm x trong bất phương trình: 3x - 7 &gt; 5
                        </h5>
                        <button class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
                            <i class="fas fa-bookmark"></i>
                        </button>
                    </div>

                    <div class="answers">
                        <label class="answer-option">
                            <input type="radio" name="question2" value="A">
                            <span>A. x &gt; 2</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question2" value="B">
                            <span>B. x &gt; 3</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question2" value="C">
                            <span>C. x &gt; 4</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question2" value="D">
                            <span>D. x &gt; 5</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Question 3 -->
            <div class="question-card" id="question-3">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="fw-bold mb-0">
                            <span class="badge bg-primary me-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">Câu 3</span>
                            Rút gọn biểu thức: (2x + 3)(x - 1) - 2x²
                        </h5>
                        <button class="btn btn-sm btn-outline-secondary" style="border-radius: 8px;">
                            <i class="fas fa-bookmark"></i>
                        </button>
                    </div>

                    <div class="answers">
                        <label class="answer-option">
                            <input type="radio" name="question3" value="A">
                            <span>A. x - 3</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question3" value="B">
                            <span>B. x + 3</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question3" value="C">
                            <span>C. -x - 3</span>
                        </label>
                        <label class="answer-option">
                            <input type="radio" name="question3" value="D">
                            <span>D. -x + 3</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-outline-secondary" style="border-radius: 12px; padding: 12px 24px;" id="prevBtn" disabled>
                    <i class="fas fa-chevron-left me-2"></i> Câu trước
                </button>
                <button class="btn btn-primary" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; border-radius: 12px; padding: 12px 24px;" id="nextBtn">
                    Câu sau <i class="fas fa-chevron-right ms-2"></i>
                </button>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="question-nav">
                <!-- Timer -->
                <div class="timer-box">
                    <div class="text-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="fas fa-clock me-2"></i>Thời gian còn lại</h6>
                    </div>
                    <div class="timer-display" id="timer">30:00</div>
                    <div class="progress mt-3" style="height: 8px; border-radius: 10px;">
                        <div class="progress-bar bg-success" id="timerProgress" style="width: 100%; border-radius: 10px;"></div>
                    </div>
                </div>

                <!-- Progress Stats -->
                <div class="progress-stats mb-3">
                    <h6 class="fw-bold mb-3"><i class="fas fa-chart-pie me-2"></i>Tiến độ</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small text-muted">Đã làm</span>
                        <span class="small fw-bold text-success"><span id="answeredCount">0</span>/20</span>
                    </div>
                    <div class="progress mb-3" style="height: 10px; border-radius: 10px;">
                        <div class="progress-bar" id="progressBar" style="width: 0%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px;"></div>
                    </div>
                    
                    <div class="d-flex gap-3 mb-3">
                        <div class="flex-grow-1 text-center p-2" style="background: #f0fff4; border-radius: 10px;">
                            <div class="small text-muted">Đã trả lời</div>
                            <div class="h5 fw-bold mb-0 text-success" id="answered">0</div>
                        </div>
                        <div class="flex-grow-1 text-center p-2" style="background: #fff5f5; border-radius: 10px;">
                            <div class="small text-muted">Chưa làm</div>
                            <div class="h5 fw-bold mb-0 text-danger" id="unanswered">20</div>
                        </div>
                    </div>
                </div>

                <!-- Question Navigation -->
                <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3"><i class="fas fa-list me-2"></i>Danh sách câu hỏi</h6>
                        <div class="d-flex flex-wrap gap-2" id="questionNav">
                            <div class="question-nav-item current" data-question="1">1</div>
                            <div class="question-nav-item" data-question="2">2</div>
                            <div class="question-nav-item" data-question="3">3</div>
                            <div class="question-nav-item" data-question="4">4</div>
                            <div class="question-nav-item" data-question="5">5</div>
                            <div class="question-nav-item" data-question="6">6</div>
                            <div class="question-nav-item" data-question="7">7</div>
                            <div class="question-nav-item" data-question="8">8</div>
                            <div class="question-nav-item" data-question="9">9</div>
                            <div class="question-nav-item" data-question="10">10</div>
                            <div class="question-nav-item" data-question="11">11</div>
                            <div class="question-nav-item" data-question="12">12</div>
                            <div class="question-nav-item" data-question="13">13</div>
                            <div class="question-nav-item" data-question="14">14</div>
                            <div class="question-nav-item" data-question="15">15</div>
                            <div class="question-nav-item" data-question="16">16</div>
                            <div class="question-nav-item" data-question="17">17</div>
                            <div class="question-nav-item" data-question="18">18</div>
                            <div class="question-nav-item" data-question="19">19</div>
                            <div class="question-nav-item" data-question="20">20</div>
                        </div>
                        
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <div class="question-nav-item current" style="width: 30px; height: 30px; font-size: 12px; pointer-events: none;"></div>
                                <span class="small text-muted">Câu hiện tại</span>
                            </div>
                            <div class="d-flex gap-2 align-items-center mb-2">
                                <div class="question-nav-item answered" style="width: 30px; height: 30px; font-size: 12px; pointer-events: none;"></div>
                                <span class="small text-muted">Đã trả lời</span>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                <div class="question-nav-item" style="width: 30px; height: 30px; font-size: 12px; pointer-events: none;"></div>
                                <span class="small text-muted">Chưa trả lời</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <button class="btn btn-submit-quiz w-100 mt-3" data-bs-toggle="modal" data-bs-target="#submitModal">
                    <i class="fas fa-paper-plane me-2"></i> Nộp bài
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Submit Confirmation Modal -->
<div class="modal fade" id="submitModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-body text-center p-5">
                <div class="mb-4" style="font-size: 64px;">⚠️</div>
                <h4 class="fw-bold mb-3">Xác nhận nộp bài?</h4>
                <p class="text-muted mb-4">
                    Bạn đã trả lời <strong class="text-primary" id="modalAnswered">0</strong> / <strong>20</strong> câu hỏi.<br>
                    Bạn có chắc chắn muốn nộp bài không?
                </p>
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1" data-bs-dismiss="modal" style="border-radius: 12px; padding: 12px;">
                        <i class="fas fa-times me-2"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-success flex-grow-1" style="border-radius: 12px; padding: 12px;" onclick="submitQuiz()">
                        <i class="fas fa-check me-2"></i> Nộp bài
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/jquery/jquery-3.5.1.min.js"></script>
    <script src="~/assets/bootstrap/4.5.3/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentQuestion = 1;
        const totalQuestions = 20;
        let answeredQuestions = new Set();
        let timeLeft = 1800; // 30 minutes in seconds
        let timerInterval;

        $(document).ready(function() {
            startTimer();
            
            // Answer selection
            $('.answer-option').on('click', function() {
                const radio = $(this).find('input[type="radio"]');
                const questionCard = $(this).closest('.question-card');
                const questionNum = questionCard.attr('id').split('-')[1];
                
                // Remove selected class from siblings
                $(this).siblings().removeClass('selected');
                
                // Add selected class to clicked option
                $(this).addClass('selected');
                
                // Check the radio button
                radio.prop('checked', true);
                
                // Mark as answered
                answeredQuestions.add(parseInt(questionNum));
                updateProgress();
                updateQuestionNav();
            });

            // Question navigation
            $('.question-nav-item').on('click', function() {
                const targetQuestion = $(this).data('question');
                scrollToQuestion(targetQuestion);
            });

            // Next/Prev buttons
            $('#nextBtn').on('click', function() {
                if (currentQuestion < totalQuestions) {
                    currentQuestion++;
                    scrollToQuestion(currentQuestion);
                }
            });

            $('#prevBtn').on('click', function() {
                if (currentQuestion > 1) {
                    currentQuestion--;
                    scrollToQuestion(currentQuestion);
                }
            });
        });

        function scrollToQuestion(questionNum) {
            currentQuestion = questionNum;
            const target = $('#question-' + questionNum);
            
            $('html, body').animate({
                scrollTop: target.offset().top - 100
            }, 500);
            
            // Update navigation
            $('.question-nav-item').removeClass('current');
            $('.question-nav-item[data-question="' + questionNum + '"]').addClass('current');
            
            // Update prev/next buttons
            $('#prevBtn').prop('disabled', currentQuestion === 1);
            $('#nextBtn').prop('disabled', currentQuestion === totalQuestions);
        }

        function updateProgress() {
            const count = answeredQuestions.size;
            const percentage = (count / totalQuestions) * 100;
            
            $('#answeredCount').text(count);
            $('#answered').text(count);
            $('#unanswered').text(totalQuestions - count);
            $('#progressBar').css('width', percentage + '%');
            $('#modalAnswered').text(count);
        }

        function updateQuestionNav() {
            answeredQuestions.forEach(function(questionNum) {
                $('.question-nav-item[data-question="' + questionNum + '"]').addClass('answered');
            });
        }

        function startTimer() {
            const totalTime = timeLeft;
            
            timerInterval = setInterval(function() {
                timeLeft--;
                
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                const display = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
                
                $('#timer').text(display);
                
                // Update progress bar
                const percentage = (timeLeft / totalTime) * 100;
                $('#timerProgress').css('width', percentage + '%');
                
                // Change color based on time left
                if (timeLeft < 300) { // Less than 5 minutes
                    $('#timer').removeClass('warning').addClass('danger');
                    $('#timerProgress').removeClass('bg-warning bg-success').addClass('bg-danger');
                } else if (timeLeft < 600) { // Less than 10 minutes
                    $('#timer').removeClass('danger').addClass('warning');
                    $('#timerProgress').removeClass('bg-success bg-danger').addClass('bg-warning');
                }
                
                // Time's up
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    alert('Hết giờ! Bài thi sẽ được tự động nộp.');
                    submitQuiz();
                }
            }, 1000);
        }

        function submitQuiz() {
            clearInterval(timerInterval);
            
            // TODO: Send answers to server
            console.log('Submitting quiz with answers:', Array.from(answeredQuestions));
            
            // Redirect to results page
            window.location.href = '/student/quiz/1/result';
        }

        // Warn before leaving
        window.addEventListener('beforeunload', function(e) {
            if (answeredQuestions.size > 0) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    </script>
}

