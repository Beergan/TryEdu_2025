@page
@model SLK.TryEdu.WebHost.Areas.Student.Pages.CoinWalletModel
@{
    ViewData["Title"] = "Ví Coin - TryEdu";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<style>
    .wallet-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 0;
        border-radius: 0 0 30px 30px;
        margin-bottom: 40px;
    }
    .coin-balance-card {
        background: white;
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .coin-balance-card::before {
        content: '💰';
        position: absolute;
        font-size: 200px;
        opacity: 0.05;
        right: -50px;
        top: -50px;
    }
    .balance-amount {
        font-size: 72px;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 20px 0;
    }
    .package-card {
        border: 3px solid #e2e8f0;
        border-radius: 20px;
        padding: 30px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        background: white;
    }
    .package-card:hover {
        border-color: #667eea;
        transform: translateY(-8px);
        box-shadow: 0 12px 32px rgba(102, 126, 234, 0.2);
    }
    .package-card.popular {
        border-color: #f59e0b;
        background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 100%);
    }
    .package-card.popular::before {
        content: '🔥 PHỔ BIẾN';
        position: absolute;
        top: -15px;
        right: 20px;
        background: #f59e0b;
        color: white;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }
    .package-amount {
        font-size: 36px;
        font-weight: 800;
        color: #1a202c;
        margin: 16px 0;
    }
    .package-coins {
        font-size: 48px;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .bonus-badge {
        background: #48bb78;
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        display: inline-block;
        margin-top: 12px;
    }
    .transaction-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .transaction-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }
    .icon-add { background: #d1fae5; }
    .icon-minus { background: #fee2e2; }
    .referral-input-group {
        position: relative;
        margin-bottom: 24px;
    }
    .referral-input {
        width: 100%;
        padding: 16px 120px 16px 20px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 16px;
        transition: all 0.3s ease;
    }
    .referral-input:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        outline: none;
    }
    .referral-apply-btn {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
    .discount-info {
        background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
        border-left: 4px solid #10b981;
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
    }
    .payment-method-card {
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .payment-method-card:hover {
        border-color: #667eea;
        background: #f7faff;
    }
    .payment-method-card.selected {
        border-color: #667eea;
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
    }
    .payment-logo {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }
</style>

<div class="wallet-header">
    <div class="container">
        <div class="text-center">
            <h1 class="display-5 fw-bold mb-3">💰 Ví Coin của bạn</h1>
            <p class="lead opacity-90">Quản lý số dư và giao dịch coin của bạn</p>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <!-- Coin Balance -->
        <div class="col-lg-8">
            <div class="coin-balance-card mb-4">
                <div class="small text-muted text-uppercase mb-2">Số dư hiện tại</div>
                <div class="balance-amount" id="coinBalance">1,250</div>
                <div class="text-muted mb-4">coins</div>
                
                <div class="row g-3 mt-4">
                    <div class="col-4">
                        <div class="small text-muted">Đã nạp</div>
                        <div class="h5 fw-bold mb-0">2,000</div>
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Đã sử dụng</div>
                        <div class="h5 fw-bold mb-0">750</div>
                    </div>
                    <div class="col-4">
                        <div class="small text-muted">Tiết kiệm</div>
                        <div class="h5 fw-bold mb-0 text-success">15%</div>
                    </div>
                </div>
            </div>

            <!-- Coin Packages -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius: 24px;">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">
                        <i class="fas fa-shopping-cart me-2" style="color: #667eea;"></i>
                        Chọn gói nạp coin
                    </h4>

                    <!-- Referral Code Input -->
                    <div class="referral-input-group">
                        <input 
                            type="text" 
                            class="referral-input" 
                            id="referralCode"
                            placeholder="Nhập mã giới thiệu để nhận ưu đãi..."
                        >
                        <button class="referral-apply-btn" onclick="applyReferralCode()">
                            Áp dụng
                        </button>
                    </div>

                    <!-- Discount Info (hidden by default) -->
                    <div class="discount-info d-none" id="discountInfo">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas fa-check-circle text-success"></i>
                            <strong>Mã giới thiệu đã được áp dụng!</strong>
                        </div>
                        <div class="small">
                            <strong>Trung tâm ABC Education</strong> • Tặng thêm <strong class="text-success">10%</strong> coin
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Package 1 -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card" onclick="selectPackage(50000, 50)">
                                <div class="text-muted small">Gói cơ bản</div>
                                <div class="package-amount">50K</div>
                                <div class="text-muted small mb-2">VNĐ</div>
                                <i class="fas fa-arrow-down my-2" style="color: #cbd5e0;"></i>
                                <div class="package-coins">50</div>
                                <div class="text-muted small">coins</div>
                            </div>
                        </div>

                        <!-- Package 2 -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card" onclick="selectPackage(100000, 100)">
                                <div class="text-muted small">Gói tiết kiệm</div>
                                <div class="package-amount">100K</div>
                                <div class="text-muted small mb-2">VNĐ</div>
                                <i class="fas fa-arrow-down my-2" style="color: #cbd5e0;"></i>
                                <div class="package-coins">105</div>
                                <div class="text-muted small">coins</div>
                                <div class="bonus-badge">+5 coins</div>
                            </div>
                        </div>

                        <!-- Package 3 - Popular -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card popular" onclick="selectPackage(500000, 500)">
                                <div class="text-muted small">Gói phổ biến</div>
                                <div class="package-amount">500K</div>
                                <div class="text-muted small mb-2">VNĐ</div>
                                <i class="fas fa-arrow-down my-2" style="color: #cbd5e0;"></i>
                                <div class="package-coins">550</div>
                                <div class="text-muted small">coins</div>
                                <div class="bonus-badge">+50 coins</div>
                            </div>
                        </div>

                        <!-- Package 4 -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card" onclick="selectPackage(1000000, 1000)">
                                <div class="text-muted small">Gói đặc biệt</div>
                                <div class="package-amount">1M</div>
                                <div class="text-muted small mb-2">VNĐ</div>
                                <i class="fas fa-arrow-down my-2" style="color: #cbd5e0;"></i>
                                <div class="package-coins">1,150</div>
                                <div class="text-muted small">coins</div>
                                <div class="bonus-badge">+150 coins</div>
                            </div>
                        </div>

                        <!-- Package 5 -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card" onclick="selectPackage(2000000, 2000)">
                                <div class="text-muted small">Gói VIP</div>
                                <div class="package-amount">2M</div>
                                <div class="text-muted small mb-2">VNĐ</div>
                                <i class="fas fa-arrow-down my-2" style="color: #cbd5e0;"></i>
                                <div class="package-coins">2,400</div>
                                <div class="text-muted small">coins</div>
                                <div class="bonus-badge">+400 coins</div>
                            </div>
                        </div>

                        <!-- Custom Amount -->
                        <div class="col-md-6 col-lg-4">
                            <div class="package-card" style="border-style: dashed;">
                                <div class="text-muted small">Số tiền tùy chỉnh</div>
                                <input 
                                    type="number" 
                                    class="form-control form-control-lg text-center fw-bold mt-2" 
                                    placeholder="Nhập số tiền"
                                    min="50000"
                                    style="border: 2px solid #e2e8f0; border-radius: 12px;"
                                >
                                <div class="text-muted small mt-2">Tối thiểu 50K VNĐ</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Methods -->
            <div class="card border-0 shadow-sm" style="border-radius: 24px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-credit-card me-2" style="color: #667eea;"></i>
                        Chọn phương thức thanh toán
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="payment-method-card selected">
                                <div class="payment-logo">💳</div>
                                <div>
                                    <div class="fw-bold">VNPay</div>
                                    <div class="small text-muted">Thẻ ATM/Visa/MasterCard</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="payment-method-card">
                                <div class="payment-logo">📱</div>
                                <div>
                                    <div class="fw-bold">MoMo</div>
                                    <div class="small text-muted">Ví điện tử MoMo</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="payment-method-card">
                                <div class="payment-logo">🏦</div>
                                <div>
                                    <div class="fw-bold">Banking</div>
                                    <div class="small text-muted">Chuyển khoản ngân hàng</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="payment-method-card">
                                <div class="payment-logo">💵</div>
                                <div>
                                    <div class="fw-bold">ZaloPay</div>
                                    <div class="small text-muted">Ví điện tử ZaloPay</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-lg w-100 mt-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; border-radius: 12px; padding: 16px; font-weight: 600;">
                        <i class="fas fa-bolt me-2"></i>
                        Nạp coin ngay
                    </button>
                </div>
            </div>
        </div>

        <!-- Transaction History -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius: 24px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-history me-2" style="color: #667eea;"></i>
                        Lịch sử giao dịch
                    </h5>

                    <!-- Transaction 1 -->
                    <div class="transaction-card">
                        <div class="transaction-icon icon-add">
                            <i class="fas fa-plus text-success"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-600">Nạp coin</div>
                            <div class="small text-muted">Hôm nay, 10:30 AM</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success">+550</div>
                            <div class="small text-muted">500K VNĐ</div>
                        </div>
                    </div>

                    <!-- Transaction 2 -->
                    <div class="transaction-card">
                        <div class="transaction-icon icon-minus">
                            <i class="fas fa-minus text-danger"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-600">Mua bài thi</div>
                            <div class="small text-muted">Hôm qua, 3:15 PM</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger">-200</div>
                            <div class="small text-muted">IELTS Mock Test</div>
                        </div>
                    </div>

                    <!-- Transaction 3 -->
                    <div class="transaction-card">
                        <div class="transaction-icon icon-add">
                            <i class="fas fa-gift text-success"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-600">Bonus từ mã giới thiệu</div>
                            <div class="small text-muted">2 ngày trước</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success">+50</div>
                            <div class="small text-muted">ABC Center</div>
                        </div>
                    </div>

                    <!-- Transaction 4 -->
                    <div class="transaction-card">
                        <div class="transaction-icon icon-minus">
                            <i class="fas fa-book text-danger"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-600">Mua khóa học</div>
                            <div class="small text-muted">3 ngày trước</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-danger">-150</div>
                            <div class="small text-muted">Advanced Grammar</div>
                        </div>
                    </div>

                    <button class="btn btn-outline-primary w-100 mt-3" style="border-radius: 12px;">
                        Xem tất cả giao dịch
                    </button>
                </div>
            </div>

            <!-- Referral Info -->
            <div class="card border-0 shadow-sm mt-4" style="border-radius: 24px; background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);">
                <div class="card-body p-4 text-center">
                    <div style="font-size: 48px; margin-bottom: 16px;">🎁</div>
                    <h5 class="fw-bold mb-2">Có mã giới thiệu?</h5>
                    <p class="small mb-3">Nhập mã từ trung tâm đối tác để nhận thêm coin khi nạp!</p>
                    <a href="#" class="btn btn-primary" style="background: linear-gradient(135deg, #7b1fa2 0%, #4a148c 100%); border: none; border-radius: 12px;">
                        Tìm hiểu thêm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/jquery/jquery-3.5.1.min.js"></script>
    <script>
        let selectedAmount = 0;
        let selectedCoins = 0;
        let referralDiscount = 0;

        function selectPackage(amount, coins) {
            selectedAmount = amount;
            selectedCoins = coins;
            
            // Remove selected class from all cards
            document.querySelectorAll('.package-card').forEach(card => {
                card.classList.remove('selected');
                card.style.borderColor = '#e2e8f0';
            });
            
            // Add selected class to clicked card
            event.currentTarget.classList.add('selected');
            event.currentTarget.style.borderColor = '#667eea';
            
            console.log(`Selected: ${amount} VNĐ = ${coins} coins`);
        }

        function applyReferralCode() {
            const code = document.getElementById('referralCode').value.trim();
            
            if (!code) {
                alert('Vui lòng nhập mã giới thiệu!');
                return;
            }
            
            // Simulate API call
            console.log('Applying referral code:', code);
            
            // Mock response
            if (code.toUpperCase() === 'ABC2024') {
                referralDiscount = 10; // 10% discount
                document.getElementById('discountInfo').classList.remove('d-none');
                
                // Update coin amounts with bonus
                document.querySelectorAll('.package-coins').forEach((el, index) => {
                    const baseCoins = [50, 105, 550, 1150, 2400];
                    const bonusCoins = Math.floor(baseCoins[index] * 0.1);
                    el.textContent = (baseCoins[index] + bonusCoins).toLocaleString();
                });
                
                alert('Mã giới thiệu hợp lệ! Bạn sẽ nhận thêm 10% coin.');
            } else {
                alert('Mã giới thiệu không hợp lệ hoặc đã hết hạn!');
            }
        }

        // Payment method selection
        document.querySelectorAll('.payment-method-card').forEach(card => {
            card.addEventListener('click', function() {
                document.querySelectorAll('.payment-method-card').forEach(c => {
                    c.classList.remove('selected');
                });
                this.classList.add('selected');
            });
        });
    </script>
}

