@page "/student/course/{id:int}"
@model SLK.TryEdu.WebHost.Areas.Student.Pages.CourseDetailModel
@{
    ViewData["Title"] = "Chi tiết Khóa học - TryEdu";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<style>
    .course-hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 50px 0;
        margin-bottom: 40px;
    }
    .course-preview-img {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    }
    .course-sidebar {
        position: sticky;
        top: 90px;
    }
    .sidebar-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        overflow: hidden;
    }
    .price-display {
        font-size: 40px;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .old-price {
        font-size: 20px;
        text-decoration: line-through;
        color: #94a3b8;
    }
    .discount-badge {
        background: #f56565;
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
    }
    .btn-enroll {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 16px;
        border-radius: 14px;
        font-size: 18px;
        font-weight: 700;
        transition: all 0.3s ease;
    }
    .btn-enroll:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
    }
    .feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
    }
    .feature-item:last-child {
        border-bottom: none;
    }
    .feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #667eea;
        font-size: 18px;
    }
    .tab-content-box {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .lesson-item {
        display: flex;
        justify-content: between;
        align-items: center;
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 12px;
        background: #f8fafc;
        transition: all 0.3s ease;
    }
    .lesson-item:hover {
        background: #f1f5f9;
        transform: translateX(4px);
    }
    .lesson-icon {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        margin-right: 16px;
    }
    .review-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        margin-bottom: 20px;
    }
    .review-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
    }
    .instructor-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        text-align: center;
    }
    .instructor-avatar-large {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid #e2e8f0;
        margin: 0 auto 20px;
    }
    .stat-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }
    .nav-pills .nav-link {
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 600;
        color: #64748b;
        transition: all 0.3s ease;
    }
    .nav-pills .nav-link.active {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    .certificate-preview {
        border: 3px dashed #cbd5e0;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        background: #f8fafc;
    }
