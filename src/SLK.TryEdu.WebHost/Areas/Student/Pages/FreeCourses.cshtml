@page
@model SLK.TryEdu.WebHost.Areas.Student.Pages.FreeCoursesModel
@{
    ViewData["Title"] = "Khóa học Miễn phí - TryEdu";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";
}

<style>
    .free-hero {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 80px 0 60px;
        margin-bottom: 50px;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
    }
    .free-hero::before {
        content: '🎁';
        position: absolute;
        font-size: 300px;
        opacity: 0.1;
        right: -50px;
        top: -50px;
    }
    .free-course-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        height: 100%;
        background: white;
        position: relative;
    }
    .free-course-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 16px 32px rgba(16, 185, 129, 0.2);
    }
    .free-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        background: #10b981;
        color: white;
        padding: 8px 16px;
        border-radius: 25px;
        font-size: 13px;
        font-weight: 700;
        z-index: 1;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }
    .course-thumbnail {
        height: 220px;
        object-fit: cover;
        width: 100%;
    }
    .category-filter {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 25px;
        border: 2px solid #e2e8f0;
        margin: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
        font-weight: 600;
    }
    .category-filter:hover, .category-filter.active {
        border-color: #10b981;
        background: #10b981;
        color: white;
    }
    .progress-badge {
        position: absolute;
        bottom: 16px;
        right: 16px;
        background: rgba(16, 185, 129, 0.95);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        z-index: 1;
    }
    .benefit-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        text-align: center;
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        height: 100%;
    }
    .benefit-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #10b98115 0%, #05966915 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        margin: 0 auto 20px;
    }
</style>

<div class="free-hero">
    <div class="container position-relative" style="z-index: 1;">
        <div class="text-center">
            <h1 class="display-4 fw-bold mb-3">🎓 Khóa học Miễn phí</h1>
            <p class="lead mb-4 opacity-90">Truy cập ngay lập tức - Không cần thanh toán!</p>
            
            <div class="row justify-content-center mt-5">
                <div class="col-md-3 text-center">
                    <div class="h2 fw-bold mb-1">50+</div>
                    <div class="opacity-75">Khóa học</div>
                </div>
                <div class="col-md-3 text-center">
                    <div class="h2 fw-bold mb-1">200+</div>
                    <div class="opacity-75">Bài học</div>
                </div>
                <div class="col-md-3 text-center">
                    <div class="h2 fw-bold mb-1">100%</div>
                    <div class="opacity-75">Miễn phí</div>
                </div>
                <div class="col-md-3 text-center">
                    <div class="h2 fw-bold mb-1">∞</div>
                    <div class="opacity-75">Không giới hạn</div>
                </div>
            </div>
        </div>
    </div>
</div>

