@page 
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SLK.TryEdu.WebHost.Areas.Student.Pages.RegisterModel
@{
    ViewData["Title"] = "Đăng ký - TryEdu AI";
    Layout = "~/Pages/Shared/_StudentLayout.cshtml";

}

<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 20px 0;">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-8">
                <div class="card shadow-lg border-0" style="border-radius: 20px; overflow: hidden; min-height: 600px;">
                    <div class="row g-0 h-100">
                        <div class="col-lg-6 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); position: relative;">
                            <div class="text-center text-white p-4">
                                <div class="mb-4">
                                    <img src="/assets/images/logo-mains.png" alt="TryEdu Logo" class="img-fluid" style="max-width: 200px; filter: brightness(0) invert(1); animation: float 3s ease-in-out infinite;">
                                </div>
                                <h1 class="h2 fw-bold mb-3">Chào mừng đến với TryEdu!</h1>
                                <p class="mb-4 opacity-75">Hệ thống học tập trực tuyến hàng đầu Việt Nam</p>
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fas fa-graduation-cap fs-5"></i>
                                        <span>Học tập linh hoạt</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fas fa-certificate fs-5"></i>
                                        <span>Chứng chỉ uy tín</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="fas fa-users fs-5"></i>
                                        <span>Cộng đồng học tập</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 d-flex align-items-center">
                            <div class="p-4 p-lg-5 w-100">
                                <div class="text-center mb-4">
                                    <h2 class="h3 fw-bold text-dark mb-2">Đăng ký tài khoản</h2>
                                    <p class="text-muted">Tạo tài khoản mới để bắt đầu học tập</p>
                                </div>

                                @if (TempData["SuccessMessage"] != null)
                                {
                                    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                                        <i class="fas fa-check-circle me-2"></i>
                                        @TempData["SuccessMessage"]
                                    </div>
                                }

                                <form id="registerForm" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <input id="firstName" name="firstName" class="form-control form-control-lg" placeholder="Họ" required />
                                            <span id="firstNameError" class="text-danger small"></span>
                                        </div>
                                        <div class="col-md-6">
                                            <input id="lastName" name="lastName" class="form-control form-control-lg" placeholder="Tên" required />
                                            <span id="lastNameError" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <input id="email" name="email" type="email" class="form-control form-control-lg" placeholder="Email" required />
                                        <span id="emailError" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <input id="password" name="password" type="password" class="form-control form-control-lg" placeholder="Mật khẩu" required />
                                        <span id="passwordError" class="text-danger small"></span>
                                        <div class="small mt-1" id="passwordStrength"></div>
                                    </div>

                                    <div class="mb-3">
                                        <input id="confirmPassword" name="confirmPassword" type="password" class="form-control form-control-lg" placeholder="Xác nhận mật khẩu" required />
                                        <span id="confirmPasswordError" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <input id="phone" name="phone" class="form-control form-control-lg" placeholder="Số điện thoại (tùy chọn)" />
                                        <span id="phoneError" class="text-danger small"></span>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-6">
                                            <input id="country" name="country" class="form-control form-control-lg" placeholder="Quốc gia (tùy chọn)" />
                                        </div>
                                        <div class="col-md-6">
                                            <input id="city" name="city" class="form-control form-control-lg" placeholder="Thành phố (tùy chọn)" />
                                        </div>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input id="agreeToTerms" name="agreeToTerms" class="form-check-input" type="checkbox" required />
                                        <label for="agreeToTerms" class="form-check-label small">
                                            Tôi đồng ý với <a href="/terms" target="_blank" class="text-decoration-none">điều khoản sử dụng</a> và <a href="/privacy" target="_blank" class="text-decoration-none">chính sách bảo mật</a>
                                        </label>
                                        <span id="agreeToTermsError" class="text-danger small"></span>
                                    </div>

                                    <div id="errorMessage" class="text-danger small mb-3"></div>
                                    <div id="successMessage" class="text-success small mb-3"></div>

                                    <button type="submit" id="registerBtn" class="btn btn-primary btn-lg w-100 mb-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                                        <i class="fas fa-user-plus me-2"></i> 
                                        <span id="registerBtnText">Đăng ký tài khoản</span>
                                        <span id="registerBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                    </button>
                                </form>
                                <div class="text-center">
                                    <p class="small text-muted">Đã có tài khoản? <a href="/login" class="text-decoration-none fw-medium">Đăng nhập ngay</a></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student-auth.js"></script>
    <script src="~/js/register.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const registerForm = document.getElementById('registerForm');
            const registerBtn = document.getElementById('registerBtn');
            const registerBtnText = document.getElementById('registerBtnText');
            const registerBtnSpinner = document.getElementById('registerBtnSpinner');
            const errorMessage = document.getElementById('errorMessage');
            const successMessage = document.getElementById('successMessage');
            const passwordInput = document.getElementById('password');
            const confirmPasswordInput = document.getElementById('confirmPassword');
            const passwordStrength = document.getElementById('passwordStrength');

            // Kiểm tra nếu đã đăng nhập, redirect về dashboard
            if (StudentAuthService.isAuthenticated()) {
                window.location.href = '/student/dashboard';
                return;
            }

            // Password strength checker
            passwordInput.addEventListener('input', function() {
                const password = this.value;
                let strength = '';
                let strengthClass = '';

                if (password.length === 0) {
                    passwordStrength.textContent = '';
                    return;
                }

                if (password.length < 6) {
                    strength = 'Mật khẩu quá ngắn (tối thiểu 6 ký tự)';
                    strengthClass = 'text-danger';
                } else if (!/(?=.*[a-z])(?=.*[A-Z])(?=.*\d)/.test(password)) {
                    strength = 'Mật khẩu phải có chữ hoa, chữ thường và số';
                    strengthClass = 'text-warning';
                } else {
                    strength = 'Mật khẩu mạnh ✓';
                    strengthClass = 'text-success';
                }

                passwordStrength.textContent = strength;
                passwordStrength.className = 'small mt-1 ' + strengthClass;
            });

            // Confirm password match
            confirmPasswordInput.addEventListener('input', function() {
                const password = passwordInput.value;
                const confirmPassword = this.value;
                const confirmPasswordError = document.getElementById('confirmPasswordError');

                if (confirmPassword && password !== confirmPassword) {
                    confirmPasswordError.textContent = 'Mật khẩu xác nhận không khớp';
                } else {
                    confirmPasswordError.textContent = '';
                }
            });

            registerForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                // Clear previous errors
                errorMessage.textContent = '';
                successMessage.textContent = '';
                document.querySelectorAll('.text-danger.small').forEach(el => {
                    if (el.id && el.id.endsWith('Error')) {
                        el.textContent = '';
                    }
                });

                // Get form values
                const firstName = document.getElementById('firstName').value.trim();
                const lastName = document.getElementById('lastName').value.trim();
                const email = document.getElementById('email').value.trim();
                const password = passwordInput.value;
                const confirmPassword = confirmPasswordInput.value;
                const phone = document.getElementById('phone').value.trim();
                const country = document.getElementById('country').value.trim();
                const city = document.getElementById('city').value.trim();
                const agreeToTerms = document.getElementById('agreeToTerms').checked;

                // Validation
                if (!firstName) {
                    document.getElementById('firstNameError').textContent = 'Họ là bắt buộc';
                    return;
                }

                if (!lastName) {
                    document.getElementById('lastNameError').textContent = 'Tên là bắt buộc';
                    return;
                }

                if (!email) {
                    document.getElementById('emailError').textContent = 'Email là bắt buộc';
                    return;
                }

                if (!password) {
                    document.getElementById('passwordError').textContent = 'Mật khẩu là bắt buộc';
                    return;
                }

                if (password !== confirmPassword) {
                    document.getElementById('confirmPasswordError').textContent = 'Mật khẩu xác nhận không khớp';
                    return;
                }

                if (!agreeToTerms) {
                    document.getElementById('agreeToTermsError').textContent = 'Vui lòng đồng ý với điều khoản sử dụng';
                    return;
                }

                // Disable button and show spinner
                registerBtn.disabled = true;
                registerBtnText.textContent = 'Đang xử lý...';
                registerBtnSpinner.classList.remove('d-none');

                try {
                    const registerData = {
                        firstName: firstName,
                        lastName: lastName,
                        email: email,
                        password: password,
                        confirmPassword: confirmPassword,
                        phone: phone || null,
                        country: country || null,
                        city: city || null,
                        agreeToTerms: agreeToTerms
                    };

                    const result = await StudentAuthService.register(registerData);

                    if (result.success) {
                        successMessage.textContent = result.message || 'Đăng ký thành công!';
                        // Redirect to dashboard after 1 second
                        setTimeout(() => {
                            window.location.href = '/student/dashboard';
                        }, 1000);
                    } else {
                        errorMessage.textContent = result.message || 'Đăng ký thất bại. Vui lòng thử lại.';
                        if (result.errors && result.errors.length > 0) {
                            result.errors.forEach(error => {
                                errorMessage.textContent += ' ' + error;
                            });
                        }
                        registerBtn.disabled = false;
                        registerBtnText.textContent = 'Đăng ký tài khoản';
                        registerBtnSpinner.classList.add('d-none');
                    }
                } catch (error) {
                    console.error('Register error:', error);
                    errorMessage.textContent = 'Đã có lỗi xảy ra. Vui lòng thử lại.';
                    registerBtn.disabled = false;
                    registerBtnText.textContent = 'Đăng ký tài khoản';
                    registerBtnSpinner.classList.add('d-none');
                }
            });
        });
    </script>
}