@page "/admin/PartnerCenter/list"
@attribute [Authorize]
@inject IPartnerCenterService _svc
@inject ISweetAlertService swal
@inject ITextTranslator Text
@inject FieldExtractor<EntityPartnerCenter> field
@inject Microsoft.JSInterop.IJSRuntime jSRuntime
@using SLK.TryEdu.ModulePartnerCore
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Inputs
@using System.Linq
@using Syncfusion.Blazor.SplitButtons
@using Syncfusion.Blazor.DropDowns
@using System.Data
@using Syncfusion.XlsIO
@using System.IO
@using Syncfusion.Blazor.Calendars

<SfDialog Target="#target" MinHeight="500px" class="dialog-create-employee" IsModal="true" ShowCloseIcon="true" @bind-Visible="_modalVisible">
    <DialogTemplates>
        <Header><span class="title">@_modalTitle</span></Header>
        <Content>
            <EditForm id="editForm" Model="@_model" OnValidSubmit="@OnFormSubmit">
                <DataAnnotationsValidator />
                
            </EditForm>
        </Content>
    </DialogTemplates>
    <DialogEvents Closed="@OnModalClosed"></DialogEvents>
    <DialogButtons>
        <DialogButton form=editForm class="btn-submit" Type="Syncfusion.Blazor.Popups.ButtonType.Submit" IsPrimary="false" Content="Xác nhận"></DialogButton>
    </DialogButtons>
</SfDialog>

<div class="app-content-wrapper">
    @if (active)
    {
        <div class="app-content-head" style="height: auto">
            <div class="row" style="padding: 0 0 0 5px">
                <div class="col-12">
                    <ol class="breadcrumb">
                        <li>Học viên</li>
                        <li style="color: #777">&nbsp; / &nbsp;</li>
                        <li class="active text-primary"> Danh sách</li>
                    </ol>
                </div>
                <div class="col-md-4 col-lg-3 d-none d-md-block">
                </div>
                <div class="col-12 col-md-8 col-lg-9 text-right">
                    <div class="btn-group pr-0">
                        <button class="btn btn-light float-right newplus mr-2" @onclick="NewUser_Click"><span class="fas fa-plus"></span> @Text["User","Học viên"]</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="app-content-body" style="overflow:auto" id="target">
            <div class="container-fluid" style="overflow:auto">
 <CustomTable TItem="EntityPartnerCenter" 
                             DataSource="@_partner"
             PageSize="25"
             TableClass="table-hover">
                 <Columns>
                        <TableColumn TItem="EntityPartnerCenter" Property="CetnterCode"
                                     Title="Mã"
                                     HeaderClass="text-dark"
                                     CellClass="fw-bold text-dark" />
                        <TableColumn TItem="EntityPartnerCenter" Property="CenterName"
                                     Title="Tên đối tác"
                                     HeaderClass="text-dark"
                                     CellClass="fw-bold text-dark"
                                     />
                        <TableColumn TItem="EntityPartnerCenter" Property="FullName"
                     Title="Họ và tên"
                                     HeaderClass="text-dark"
                     CellClass="fw-bold text-dark"
                                      />
                        <TableColumn TItem="EntityPartnerCenter" Property="Phone"
                     Title="Số điện thoại"
                     HeaderClass="text-center"
                     CellClass="text-center text-success" />
                        <TableColumn TItem="EntityPartnerCenter" Property="Email"
                                     Title="Email"
                                     HeaderClass="text-dark"
                                     CellClass="fst-italic">
                        </TableColumn>
                       <TableColumn TItem="EntityPartnerCenter" Property="Address"
                     Title="Địa chỉ"
                     HeaderClass="text-muted"
                     CellClass="text-secondary" />
                </Columns>
                <Actions>
                    @{
                        var user = context;
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" @onclick="() => EditUser(user.Id)">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-outline-danger" @onclick="() => DeleteUser(user.Id)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    }
                </Actions>
        </CustomTable> 
            </div>
        </div>
    }
</div>

@code {
    #region vavariables
    [Parameter]
    public string str { get; set; }
    private List<EntityPartnerCenter> _partner = new();
    private IEnumerable<EntityPartnerCenter> _dataSource = new List<EntityPartnerCenter>();
    private List<EntityPartnerCenter> _displaySource = new();
    private List<OptionItem<Guid>> _optOffices = new();
    private List<OptionItem<Guid>> _optJob = new();

    private EntityPartnerCenter _model = new();
    private bool active = false;
    private bool _modalVisible = false;
    private bool _filter = false;
    private string _modalTitle;
    private string _filterSearch;
    #endregion

    #region events
    protected override async Task OnInitializedAsync()
    {
        _ = swal.Loading("Nạp thông tin ..");

        _optOffices = await _svc.GetOptionOffices();
        _optJob = await _svc.GetOptionJob();

        await RereshData();
        StateHasChanged();
    }

    private void NewUser_Click()
    {
        _modalTitle = "Thêm nhân sự mới";
        _modalVisible = true;
    }

    private void OnModalClosed(Object args)
    {
        _model = new EntityPartnerCenter();
    }
    #endregion

    #region methods
    private async Task RereshData()
    {
        var rsp = await AppStatic.CallApi(() => _svc.GetList());
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }

        active = true;
        _dataSource = rsp.Items;

        _displaySource = _dataSource.OrderByDescending(x => x.Id).ToList();

        await swal.Close();
        StateHasChanged();
    }

    private async void OnFormSubmit()
    {
        _modalVisible = false;
        _ = swal.Loading("Lưu thông tin..");

        var rsp = await AppStatic.CallApi(() => _svc.Save(_model));
        if (!rsp.Success)
        {
            _ = swal.Error(rsp.Message);
            return;
        }
        await RereshData();
    }

    private void OnChange()
    {
        var query = _dataSource.AsQueryable();

        

        _displaySource = query.OrderByDescending(o => o.Id).ToList();
        StateHasChanged();
    }

    private async void EditUser(int id)
    {
        var item = _dataSource.Single(t => t.Id == id);
        _model = item;
        _modalTitle = "Hiệu chỉnh nhân sự";
        _modalVisible = true;
        await Task.CompletedTask;
    }

    private void DeleteUser(int id)
    {
        var user = _partner.FirstOrDefault(u => u.Id == id);
        if (user != null)
        {
            _partner.Remove(user);
            StateHasChanged();
        }
    }
    #endregion
}